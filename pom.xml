<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>dev.storyblock</groupId>
  <artifactId>storyblock-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>StoryBlock Engine</name>
  <description>Immutable, evidence-bound narrative editing engine</description>

  <modules>
    <module>modules/domain</module>
    <module>modules/contracts</module>
    <module>modules/application</module>
    <module>modules/renderer</module>
    <module>modules/validator</module>
    <module>modules/detector</module>
    <module>modules/style</module>
    <module>modules/security</module>
    <module>modules/storage-api</module>
    <module>modules/storage-sqlite</module>
    <module>modules/monitor-adapter</module>
    <module>modules/rewrite</module>
    <module>apps/api</module>
    <module>apps/style-worker</module>
    <module>apps/llm-worker</module>
    <module>apps/cli</module>
    <module>tests/architecture-tests</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <sqlite-jdbc.version>3.53.2.1</sqlite-jdbc.version>
    <archunit.version>1.4.1</archunit.version>
    <jqwik.version>1.9.3</jqwik.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-renderer</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-validator</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-detector</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-style</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-storage-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-storage-sqlite</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-monitor-adapter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-rewrite</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>enforce-build-toolchain</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.6.3,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.3</version>
          <configuration>
            <useModulePath>false</useModulePath>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.5.3</version>
          <configuration>
            <useModulePath>false</useModulePath>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
