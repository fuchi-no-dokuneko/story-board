      const response = await client.request({
        method: "POST",
        pathname: `/v1/novels/${encodeURIComponent(novelId)}/images`,
        headers: {
          "Content-Type": mediaType,
          "If-Match": quoted(novel.head.head_hash),
          "Idempotency-Key": idempotencyKey,
