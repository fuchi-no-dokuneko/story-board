{
  "type": "object",
  "required": [
    "operation_id",
    "idempotency_key",
    "novel_id",
    "base_revision_id",
    "expected_head_hash",
    "type",
    "payload"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "pattern": "^op_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "novel_id": {
      "type": "string",
      "pattern": "^nov_[A-Za-z0-9]{5}$"
    },
    "base_revision_id": {
      "type": "string",
      "pattern": "^rev_[A-Za-z0-9]{5}$"
    },
    "expected_head_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "type": {
      "const": "merge_blocks"
    },
    "payload": {
      "$ref": "MergeBlocksPayload.schema.json"
    }
  },
  "additionalProperties": false,
