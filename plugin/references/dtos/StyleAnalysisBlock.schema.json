{
  "type": "object",
  "required": [
    "block",
    "intentional_style_shift_reason",
    "narrative_mode",
    "pov",
    "scene_id",
    "speaker_id",
    "stratum_kind"
  ],
  "properties": {
    "block": {
      "$ref": "StyleAnalysisNarrativeBlock.schema.json"
    },
    "intentional_style_shift_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "narrative_mode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "pov": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scene_id": {
      "type": "string",
      "pattern": "^scn_[A-Za-z0-9]{5}$"
    },
    "speaker_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
    },
    "stratum_kind": {
      "type": "string",
      "enum": [
        "narration",
        "dialogue"
      ]
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyblock.local/plugin/dtos/StyleAnalysisBlock.schema.json",
  "title": "StyleAnalysisBlock",
  "description": "Code-derived StoryBlock Style Analysis Block JSON contract.",
  "x-confidence": "confirmed-from-code",
  "x-source": [
    "server/src/main/java/dev/storyblock/api/http/StyleAnalysisController.java",
    "server/src/main/java/dev/storyblock/api/http/StyleProfileController.java",
    "modules/style/src/main/java/dev/storyblock/style"
  ],
  "examples": [
    {
