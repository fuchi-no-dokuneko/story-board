{
  "type": "object",
  "required": [
    "block_id",
    "block_version_id",
    "text",
    "local_meta"
  ],
  "properties": {
    "block_id": {
      "type": "string",
      "pattern": "^blk_[A-Za-z0-9]{5}$"
    },
    "block_version_id": {
      "type": "string",
      "pattern": "^blv_[A-Za-z0-9]{5}$"
    },
    "text": {
      "type": "string"
    },
    "local_meta": {
      "type": "object",
      "additionalProperties": true
    },
    "image": {
      "$ref": "BlockImage.schema.json"
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyblock.local/plugin/dtos/RenderedBlock.schema.json",
  "title": "RenderedBlock",
  "description": "Code-derived StoryBlock Rendered Block JSON contract.",
  "x-confidence": "confirmed-from-code",
  "x-source": [
    "server/src/main/java/dev/storyblock/api/http/RenderController.java",
    "modules/renderer/src/main/java/dev/storyblock/renderer/RenderPacket.java"
  ],
  "examples": [
    {
      "block_id": "blk_49pHt",
      "block_version_id": "blv_xwDzm",
      "text": "春風到了。",
      "local_meta": {
      }
    }
  ]
}
