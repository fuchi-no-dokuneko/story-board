{
  "type": "object",
  "required": [
    "novel_id",
    "revision_id",
    "revision_hash",
    "renderer_version",
    "range",
    "rendered_text",
    "blocks",
    "resolved_meta",
    "offset_map",
    "scene_boundaries"
  ],
  "properties": {
    "novel_id": {
      "type": "string",
      "pattern": "^nov_[A-Za-z0-9]{5}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^rev_[A-Za-z0-9]{5}$"
    },
    "revision_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "renderer_version": {
      "type": "string"
    },
    "range": {
      "$ref": "RenderRange.schema.json"
    },
    "rendered_text": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "RenderedBlock.schema.json"
      }
    },
    "resolved_meta": {
      "type": "array",
      "items": {
        "$ref": "ResolvedBlockMetadata.schema.json"
      }
    },
    "offset_map": {
      "type": "array",
      "items": {
        "$ref": "RenderOffset.schema.json"
      }
    },
    "scene_boundaries": {
      "type": "array",
      "items": {
        "$ref": "ResolvedSceneBoundary.schema.json"
      }
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyblock.local/plugin/dtos/RenderPacket.schema.json",
  "title": "RenderPacket",
  "description": "Code-derived StoryBlock Render Packet JSON contract.",
  "x-confidence": "confirmed-from-code",
  "x-source": [
    "server/src/main/java/dev/storyblock/api/http/RenderController.java",
    "modules/renderer/src/main/java/dev/storyblock/renderer/RenderPacket.java"
  ],
  "examples": [
    {
      "novel_id": "nov_EUubI",
      "revision_id": "rev_mG1Ct",
      "revision_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "renderer_version": "example-1",
      "range": {
        "from_block_id": "example-1",
        "to_block_id": "example-1"
      },
      "rendered_text": "example-1",
      "blocks": [

      ],
      "resolved_meta": [

      ],
      "offset_map": [

      ],
      "scene_boundaries": [

      ]
    }
  ]
}
