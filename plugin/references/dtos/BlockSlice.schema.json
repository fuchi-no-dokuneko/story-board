{
  "type": "object",
  "properties": {
    "novel_id": {
      "type": "string",
      "pattern": "^nov_[A-Za-z0-9]{5}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^rev_[A-Za-z0-9]{5}$"
    },
    "revision_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scene_id": {
      "type": "string",
      "pattern": "^scn_[A-Za-z0-9]{5}$"
    },
    "chapter_id": {
      "type": "string",
      "pattern": "^ch_[A-Za-z0-9]{5}$"
    },
    "block_count": {
      "type": "integer",
      "minimum": 0
    },
    "slice": {
      "$ref": "IndexSlice.schema.json"
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "BlockSliceItem.schema.json"
      }
    }
  },
  "required": [
    "novel_id",
    "revision_id",
    "revision_hash",
    "scene_id",
    "chapter_id",
    "block_count",
    "slice",
    "blocks"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyblock.local/plugin/dtos/BlockSlice.schema.json",
  "title": "BlockSlice",
  "description": "Revision-bound scene block slice; [0,0) reads an empty scene.",
  "x-confidence": "confirmed-from-code",
  "x-source": [
    "server/src/main/java/dev/storyblock/api/http/NarrativeReadController.java"
  ],
  "examples": [
    {
      "novel_id": "nov_Ab123",
      "revision_id": "rev_Cd456",
      "revision_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "scene_id": "scn_Bb234",
      "chapter_id": "ch_Aa123",
      "block_count": 1,
      "slice": {
        "start": 0,
        "end": 1
      },
      "blocks": [
        {
          "index": 0,
          "block_id": "blk_Cc345",
          "block_version_id": "blv_Dd456",
          "order_key": "a0",
          "text": "清晨下雨。",
          "meta": {},
          "extensions": {}
        }
      ]
    }
  ]
}
