      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "scene_id",
    "index",
    "chapter_id",
    "chapter_index",
    "title",
    "block_count",
    "block_slice",
    "total_text_graphemes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyblock.local/plugin/dtos/SceneListItem.schema.json",
  "title": "SceneListItem",
  "description": "Scene distribution; text length counts Unicode graphemes including punctuation.",
  "x-confidence": "confirmed-from-code",
  "x-source": [
    "server/src/main/java/dev/storyblock/api/http/NarrativeReadController.java"
