      "type": "string",
      "pattern": "^ch_[A-Za-z0-9]{5}$"
    },
    "chapter_index": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string"
    },
    "block_count": {
      "type": "integer",
      "minimum": 0
    },
