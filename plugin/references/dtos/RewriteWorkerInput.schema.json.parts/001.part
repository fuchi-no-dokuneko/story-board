{
  "type": "object",
  "required": [
    "analysis_id",
    "analyzer_contract_hash",
    "blocks",
    "constraints",
    "finding_ids",
    "novel_id",
    "profile_version_hash",
    "profile_version_id",
    "proposal_id",
    "revision_hash",
    "revision_id",
    "schema_version",
    "window_configuration_hash"
  ],
  "properties": {
    "analysis_id": {
      "type": "string",
      "pattern": "^ana_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "analyzer_contract_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "$ref": "RewriteSourceBlock.schema.json"
      }
    },
    "constraints": {
      "$ref": "RewriteConstraints.schema.json"
    },
    "finding_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "novel_id": {
      "type": "string",
      "pattern": "^nov_[A-Za-z0-9]{5}$"
    },
    "profile_version_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profile_version_id": {
      "type": "string",
      "pattern": "^spv_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^prp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^rev_[A-Za-z0-9]{5}$"
    },
    "schema_version": {
      "type": "string"
    },
    "window_configuration_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyblock.local/plugin/dtos/RewriteWorkerInput.schema.json",
  "title": "RewriteWorkerInput",
  "description": "Code-derived StoryBlock Rewrite Worker Input JSON contract.",
  "x-confidence": "confirmed-from-code",
  "x-source": [
    "server/src/main/java/dev/storyblock/api/http/RewriteProposalController.java",
    "modules/rewrite/src/main/java/dev/storyblock/rewrite/RewriteWorkerInput.java",
    "modules/rewrite-policy/src/main/java/dev/storyblock/rewrite/policy/RewriteCandidateReservation.java"
  ],
