{
  "type": "object",
  "required": [
    "novel_id",
    "kind",
    "subject_id"
  ],
  "properties": {
    "novel_id": {
      "type": "string",
      "pattern": "^nov_[A-Za-z0-9]{5}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "novel",
        "series",
        "character"
      ]
    },
    "subject_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyblock.local/plugin/dtos/StyleProfileScope.schema.json",
  "title": "StyleProfileScope",
  "description": "Code-derived StoryBlock Style Profile Scope JSON contract.",
  "x-confidence": "confirmed-from-code",
  "x-source": [
    "server/src/main/java/dev/storyblock/api/http/StyleAnalysisController.java",
    "server/src/main/java/dev/storyblock/api/http/StyleProfileController.java",
    "modules/style/src/main/java/dev/storyblock/style"
  ],
  "examples": [
    {
      "novel_id": "nov_EUubI",
      "kind": "novel",
      "subject_id": "example-1"
    }
  ]
}
