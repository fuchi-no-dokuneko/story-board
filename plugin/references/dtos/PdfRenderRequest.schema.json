{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyblock.local/plugin/dtos/PdfRenderRequest.schema.json",
  "title": "PdfRenderRequest",
  "description": "Request to render one immutable full revision as PDF.",
  "type": "object",
  "required": ["revision_id"],
  "properties": {
    "revision_id": {
      "type": "string",
      "pattern": "^rev_[A-Za-z0-9]{5}$"
    }
  },
  "additionalProperties": false,
  "x-confidence": "confirmed-from-code",
  "x-source": [
    "server/src/main/java/dev/storyblock/api/http/PdfRenderController.java",
    "server/src/main/resources/openapi/storyblock-v1.yaml"
  ],
  "examples": [
    {"revision_id": "rev_mG1Ct"}
  ]
}
