{
  "type": "object",
  "required": [
    "id",
    "text",
    "meta"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^blk_[A-Za-z0-9]{5}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "x-storyblock-max-graphemes": 100,
      "x-storyblock-sentence-count": [
        1,
        2
      ]
    },
    "meta": {
      "$ref": "BlockMetadata.schema.json"
    },
    "extensions": {
      "type": "object",
      "properties": {
        "storyblock.image": false
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9.-]{1,63}$"
      }
    },
    "image": {
      "$ref": "BlockImage.schema.json"
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyblock.local/plugin/dtos/BlockDraft.schema.json",
  "title": "BlockDraft",
  "description": "Code-derived StoryBlock Block Draft JSON contract.",
  "x-confidence": "confirmed-from-code",
  "x-source": [
    "server/src/main/java/dev/storyblock/api/http/PreviewController.java",
    "server/src/main/java/dev/storyblock/api/http/CommitController.java",
    "modules/contracts/src/main/java/dev/storyblock/contracts/EditOperationCanonicalMapper.java",
    "modules/domain/src/main/java/dev/storyblock/domain/EditOperation.java"
  ],
  "examples": [
    {
      "id": "blk_49pHt",
      "text": "春風到了。",
      "meta": {
      }
    }
  ]
}
