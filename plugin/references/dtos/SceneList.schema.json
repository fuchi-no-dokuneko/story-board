{
  "type": "object",
  "properties": {
    "novel_id": {
      "type": "string",
      "pattern": "^nov_[A-Za-z0-9]{5}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^rev_[A-Za-z0-9]{5}$"
    },
    "revision_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "chapter_slice": {
      "$ref": "IndexSlice.schema.json"
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "SceneListItem.schema.json"
      }
    }
  },
  "required": [
    "novel_id",
    "revision_id",
    "revision_hash",
    "chapter_slice",
    "scenes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyblock.local/plugin/dtos/SceneList.schema.json",
  "title": "SceneList",
  "description": "Scenes selected by a half-open chapter index slice. No body text.",
  "x-confidence": "confirmed-from-code",
  "x-source": [
    "server/src/main/java/dev/storyblock/api/http/NarrativeReadController.java"
  ],
  "examples": [
    {
      "novel_id": "nov_Ab123",
      "revision_id": "rev_Cd456",
      "revision_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "chapter_slice": {
        "start": 0,
        "end": 1
      },
      "scenes": [
        {
          "scene_id": "scn_Bb234",
          "index": 0,
          "chapter_id": "ch_Aa123",
          "chapter_index": 0,
          "title": "清晨",
          "block_count": 1,
          "block_slice": {
            "start": 0,
            "end": 1
          },
          "total_text_graphemes": 5
        }
      ]
    }
  ]
}
