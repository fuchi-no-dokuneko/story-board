{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyblock.local/plugin/dtos/CharacterImageReferenceConfig.schema.json",
  "title": "CharacterImageReferenceConfig",
  "description": "Character visual identity references with one initial image and at least two plain-background variants each.",
  "type": "object",
  "required": ["schema_version", "characters"],
  "properties": {
    "schema_version": {"const": "character-image-references-1.0.0"},
    "characters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/character"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["label", "background", "image"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "background": {"const": "plain"},
        "image": {"$ref": "BlockImage.schema.json"}
      },
      "additionalProperties": false
    },
    "character": {
      "type": "object",
      "required": ["character_id", "name", "identity_lock", "initial", "variants"],
      "properties": {
        "character_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "identity_lock": {"type": "string", "minLength": 1, "maxLength": 2000},
        "initial": {
          "allOf": [
            {"$ref": "#/$defs/asset"},
            {"properties": {"label": {"const": "initial"}}}
          ]
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/asset"}
        }
      },
      "additionalProperties": false
    }
  },
  "x-confidence": "skill-policy",
  "x-source": [
    "plugin/SKILL.md",
    "modules/domain/src/main/java/dev/storyblock/domain/BlockImage.java"
  ],
  "examples": [
    {
      "schema_version": "character-image-references-1.0.0",
      "characters": [
        {
          "character_id": "character-one",
          "name": "角色一",
          "identity_lock": "固定髮型、面形、服裝與隨身道具。",
          "initial": {
            "label": "initial",
            "background": "plain",
            "image": {"artifact_id": "art_018f0f5e-7b4a-7c00-8000-000000000001", "content_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "media_type": "image/png", "width_px": 1024, "height_px": 1024, "alt_text": "角色一的初始參考圖。"}
          },
          "variants": [
