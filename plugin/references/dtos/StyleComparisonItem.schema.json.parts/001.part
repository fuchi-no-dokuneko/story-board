{
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "stale",
        "unavailable"
      ]
    },
    "reference_file_count": {
      "type": "integer",
      "minimum": 0
    },
    "reference_graphemes": {
      "type": "integer",
      "minimum": 0
    },
    "benchmark_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "type": "string"
    },
    "scores": {
