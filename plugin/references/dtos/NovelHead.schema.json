{
  "type": "object",
  "required": [
    "novel_id",
    "head_revision_id",
    "head_sequence",
    "head_hash",
    "schema_version"
  ],
  "properties": {
    "novel_id": {
      "type": "string",
      "pattern": "^nov_[A-Za-z0-9]{5}$"
    },
    "head_revision_id": {
      "type": "string",
      "pattern": "^rev_[A-Za-z0-9]{5}$"
    },
    "head_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "head_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyblock.local/plugin/dtos/NovelHead.schema.json",
  "title": "NovelHead",
  "description": "Code-derived StoryBlock Novel Head JSON contract.",
  "x-confidence": "confirmed-from-code",
  "x-source": [
    "server/src/main/java/dev/storyblock/api/http/CanonicalTransferController.java",
    "server/src/main/java/dev/storyblock/api/http/NovelController.java",
    "modules/contracts/src/main/java/dev/storyblock/contracts/CanonicalRevision.java",
    "modules/contracts/src/main/java/dev/storyblock/contracts/CanonicalNovelPackage.java"
  ],
  "examples": [
    {
      "novel_id": "nov_EUubI",
      "head_revision_id": "rev_mG1Ct",
      "head_sequence": 0,
      "head_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "schema_version": "example-1"
    }
  ]
}
