{
  "type": "object",
  "required": [
    "novel_id",
    "revision_id",
    "revision_hash",
    "monitor_version",
    "rule_version",
    "detector_rule_version",
    "target_block_id",
    "neighbor_count",
    "render_packet",
    "detector_findings",
    "local_invariants",
    "allowed_tools"
  ],
  "properties": {
    "novel_id": {
      "type": "string",
      "pattern": "^nov_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "monitor_version": {
      "type": "string"
    },
    "rule_version": {
      "type": "string"
    },
    "detector_rule_version": {
      "type": "string"
    },
    "target_block_id": {
      "type": "string",
      "pattern": "^blk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "neighbor_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "render_packet": {
      "$ref": "RenderPacket.schema.json"
    },
    "detector_findings": {
      "type": "array",
      "items": {
        "$ref": "DetectorFinding.schema.json"
      }
    },
    "local_invariants": {
      "$ref": "MonitorLocalInvariants.schema.json"
    },
    "allowed_tools": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "const": "submit_finding"
        },
        {
          "const": "submit_proposed_operation"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyblock.local/plugin/dtos/MonitorPacket.schema.json",
  "title": "MonitorPacket",
  "description": "Code-derived StoryBlock Monitor Packet JSON contract.",
  "x-confidence": "confirmed-from-code",
  "x-source": [
    "server/src/main/java/dev/storyblock/api/http/MonitorController.java",
    "modules/monitor-adapter/src/main/java/dev/storyblock/monitor/MonitorPacket.java",
    "modules/monitor-adapter/src/main/java/dev/storyblock/monitor/MonitorRunStatus.java"
  ],
  "examples": [
    {
      "novel_id": "nov_018f0f5e-7b4a-7c00-8000-000000000001",
      "revision_id": "rev_018f0f5e-7b4a-7c00-8000-000000000001",
      "revision_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "monitor_version": "example-1",
      "rule_version": "example-1",
      "detector_rule_version": "example-1",
      "target_block_id": "blk_018f0f5e-7b4a-7c00-8000-000000000001",
      "neighbor_count": 1,
      "render_packet": {
