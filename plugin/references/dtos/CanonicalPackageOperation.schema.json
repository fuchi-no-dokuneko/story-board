    "sequence",
    "operation_hash",
    "operation",
    "result_revision_id",
    "result_hash",
    "committed_at"
  ],
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "operation_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "operation": {
