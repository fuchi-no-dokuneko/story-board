      "method": "POST",
      "path": "/v1/style-profiles/{profileId}/versions",
      "summary": "Create an immutable DRAFT profile baseline version",
      "auth": "bearer-or-trusted-lan-owner",
      "scopes": [
        "style:admin"
      ],
      "roles": [],
      "pathParameters": [
        {
          "name": "profileId",
          "required": true,
          "schema": {
            "type": "string",
