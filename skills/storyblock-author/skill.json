{
  "name": "storyblock-author",
  "version": "1.1.0",
  "description": "Standalone StoryBlock API discovery, validation, bulk registration, and incremental authoring skill",
  "entrypoint": "scripts/storyblock-author.mjs",
  "runtime": {
    "name": "node",
    "minimumVersion": "20",
    "dependencies": []
  },
  "capabilities": [
    "api-discovery",
    "dto-validation",
    "bulk-novel-registration",
    "persistence-verification",
    "incremental-editing",
    "commit-preview",
    "rendering",
    "image-blocks",
    "pdf-rendering",
    "export-import",
    "problem-diagnostics"
  ],
  "environment": {
    "required": [],
    "optional": [
      "STORYBLOCK_BASE_URL",
      "STORYBLOCK_ACCESS_KEY",
      "STORYBLOCK_TIMEOUT_MS",
      "STORYBLOCK_USER_AGENT"
    ]
  },
  "transport": {
    "scheme": "https",
    "defaultBaseUrl": "https://127.0.0.1:8443",
    "selfSignedCertificate": true,
    "ipv4Only": true
  }
}
