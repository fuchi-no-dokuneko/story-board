              "license": "example-1",
              "ownership": "example-1"
            }
          ],
          "feature_set": {
            "source_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
