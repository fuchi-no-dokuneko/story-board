{
  "type": "object",
  "required": [
    "source_id",
    "content_hash",
    "kind",
    "provenance",
    "license",
    "ownership"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:@-]{1,128}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "owner",
        "licensed",
        "public_domain",
        "generated",
        "mixed"
      ]
    },
    "provenance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "ownership": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyblock.local/skills/storyblock-author/dtos/StyleCorpusSource.schema.json",
  "title": "StyleCorpusSource",
  "description": "Code-derived StoryBlock Style Corpus Source JSON contract.",
  "x-confidence": "confirmed-from-code",
  "x-source": [
    "apps/api/src/main/java/dev/storyblock/api/http/StyleAnalysisController.java",
    "apps/api/src/main/java/dev/storyblock/api/http/StyleProfileController.java",
    "modules/style/src/main/java/dev/storyblock/style"
  ],
  "examples": [
    {
      "source_id": "example-1",
      "content_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "kind": "owner",
      "provenance": "example-1",
      "license": "example-1",
      "ownership": "example-1"
    }
  ]
}
