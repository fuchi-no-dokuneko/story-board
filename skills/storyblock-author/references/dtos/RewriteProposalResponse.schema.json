{
  "type": "object",
  "required": [
    "analysis_id",
    "cooldown_until",
    "finding_ids",
    "novel_id",
    "proposal_id",
    "reservation_hash",
    "revision_hash",
    "revision_id",
    "status",
    "worker_input"
