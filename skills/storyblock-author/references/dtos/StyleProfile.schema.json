      "type": "string",
      "pattern": "^spf_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string"
    },
    "scope": {
      "$ref": "StyleProfileScope.schema.json"
    },
    "provenance": {
      "type": "string"
    },
    "created_by": {
