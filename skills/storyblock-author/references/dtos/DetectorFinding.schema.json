{
  "type": "object",
  "required": [
    "finding_id",
    "code",
    "severity",
    "revision_id",
    "revision_hash",
    "rule_version",
    "affected_block_ids",
    "affected_scene_ids",
    "context_block_ids",
    "evidence"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^fnd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "code": {
      "type": "string",
      "enum": [
        "LOCATION_CHANGED_WITHOUT_TRANSITION",
        "CHARACTER_APPEARED_WITHOUT_ENTER",
        "CHARACTER_DISAPPEARED_WITHOUT_EXIT",
        "WEATHER_CHANGED_WITHOUT_EVIDENCE",
        "TIME_DISCONTINUITY",
        "POV_CHANGED_WITHOUT_BOUNDARY",
        "META_TEXT_MISMATCH",
        "INTENTIONAL_SCENE_RESET"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "revision_id": {
      "type": "string",
      "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rule_version": {
      "type": "string"
    },
    "affected_block_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "affected_scene_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "context_block_ids": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyblock.local/skills/storyblock-author/dtos/DetectorFinding.schema.json",
  "title": "DetectorFinding",
  "description": "Code-derived StoryBlock Detector Finding JSON contract.",
  "x-confidence": "confirmed-from-code",
  "x-source": [
