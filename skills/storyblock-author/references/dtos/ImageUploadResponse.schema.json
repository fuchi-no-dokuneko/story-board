{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyblock.local/skills/storyblock-author/dtos/ImageUploadResponse.schema.json",
  "title": "ImageUploadResponse",
  "description": "Immutable portable image artifact created by the image upload endpoint.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_uri",
    "content_hash",
    "media_type",
    "width_px",
    "height_px",
    "idempotent_replay"
  ],
  "properties": {
    "schema_version": {"const": "image-upload-1.0.0"},
    "artifact_id": {
      "type": "string",
      "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "artifact_uri": {"type": "string", "pattern": "^/v1/artifacts/art_[0-9a-f-]{36}$"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "media_type": {"type": "string", "enum": ["image/png", "image/jpeg"]},
    "width_px": {"type": "integer", "minimum": 1, "maximum": 8192},
    "height_px": {"type": "integer", "minimum": 1, "maximum": 8192},
    "idempotent_replay": {"type": "boolean"}
  },
  "additionalProperties": false,
  "x-confidence": "confirmed-from-code",
  "x-source": [
    "apps/api/src/main/java/dev/storyblock/api/http/ImageController.java",
    "modules/application/src/main/java/dev/storyblock/application/ImageUploadService.java"
  ],
  "examples": [
    {
      "schema_version": "image-upload-1.0.0",
      "artifact_id": "art_018f0f5e-7b4a-7c00-8000-000000000001",
      "artifact_uri": "/v1/artifacts/art_018f0f5e-7b4a-7c00-8000-000000000001",
      "content_hash": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "media_type": "image/png",
      "width_px": 1024,
      "height_px": 1024,
      "idempotent_replay": false
    }
  ]
}
