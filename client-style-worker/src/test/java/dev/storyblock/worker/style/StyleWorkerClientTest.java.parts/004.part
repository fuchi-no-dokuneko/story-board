                    Ids.BlockId.create(),
                    OrderKey.rebalanced(index, 60),
                    "Measured narrative sentence %02d repeats a stable cadence."
                            .formatted(index),
                    BlockMetadata.empty(),
                    Map.of()
            );
            narrativeBlocks.add(block);
            analysisBlocks.add(new StyleAnalysisBlock(
                    sceneId,
