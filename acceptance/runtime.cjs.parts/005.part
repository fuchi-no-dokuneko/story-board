async function closeWorld(world) {
  await finishRecording(world);
  if (world.driver) {
    await world.driver.quit();
    world.driver = null;
  }
}

module.exports = {
  beginRecording,
  captureScenario,
  chooseValue,
  clickCss,
  closeWorld,
