                }
                current[s] = best + emission.get(s).getOrDefault(text[start + i], MIN);
            }
            previous = current;
        }
        int state = previous[2] >= previous[3] ? 2 : 3;
        byte[] states = new byte[count];
        for (int i = count - 1; i >= 0; i--) { states[i] = (byte) state; state = route[i][state]; }
        int begin = start;
        for (int i = 0; i < count; i++) {
            if (states[i] == 2 || states[i] == 3) { output.accept(begin, start + i + 1); begin = start + i + 1; }
        }
        if (begin < end) output.accept(begin, end);
    }
}
