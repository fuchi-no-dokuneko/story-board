                MonitorBlockFingerprint.from(block)
        );
        String requestHash = StoredMonitorRun.requestHash(
                revision.novel().id(),
                revision.id(),
                revisionHash,
                block.id(),
                1,
                MonitorModule.VERSION,
                ruleVersion,
                affected,
                finding
        );
        return new StoredMonitorRun(
                Ids.MonitorRunId.create(),
                Ids.MonitorIssueId.create(),
