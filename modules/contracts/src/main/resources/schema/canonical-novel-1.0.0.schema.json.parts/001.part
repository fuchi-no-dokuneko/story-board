{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyblock.local/schema/canonical-novel-1.0.0.schema.json",
  "title": "StoryBlock canonical novel revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chapters",
    "content_hash",
    "created_at",
    "novel_id",
    "parent_revision_id",
    "revision_id",
    "schema_version"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "novel_id": {"$ref": "#/$defs/novelId"},
    "revision_id": {"$ref": "#/$defs/revisionId"},
    "parent_revision_id": {
      "oneOf": [
        {"$ref": "#/$defs/revisionId"},
        {"type": "null"}
      ]
    },
    "content_hash": {"$ref": "#/$defs/contentHash"},
    "created_at": {"type": "string", "format": "date-time"},
    "chapters": {
      "type": "array",
      "items": {"$ref": "#/$defs/chapter"}
    },
    "extensions": {"$ref": "#/$defs/extensions"}
  },
  "$defs": {
    "novelId": {
      "type": "string",
      "pattern": "^nov_[A-Za-z0-9]{5}$"
    },
    "chapterId": {
      "type": "string",
      "pattern": "^ch_[A-Za-z0-9]{5}$"
    },
    "sceneId": {
      "type": "string",
      "pattern": "^scn_[A-Za-z0-9]{5}$"
    },
    "blockId": {
      "type": "string",
      "pattern": "^blk_[A-Za-z0-9]{5}$"
    },
    "blockVersionId": {
      "type": "string",
      "pattern": "^blv_[A-Za-z0-9]{5}$"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^rev_[A-Za-z0-9]{5}$"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "orderKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9.-]{1,63}$"}
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order_key", "scenes"],
      "properties": {
        "id": {"$ref": "#/$defs/chapterId"},
        "order_key": {"$ref": "#/$defs/orderKey"},
        "title": {"type": "string"},
        "scenes": {
          "type": "array",
          "items": {"$ref": "#/$defs/scene"}
        },
        "extensions": {"$ref": "#/$defs/extensions"}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocks", "chapter_id", "id", "order_key", "transition_mode"],
      "properties": {
        "id": {"$ref": "#/$defs/sceneId"},
