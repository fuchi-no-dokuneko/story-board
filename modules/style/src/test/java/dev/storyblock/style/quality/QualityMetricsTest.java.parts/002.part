        assertEquals(0.2,report.statistics().mattr(),1e-12);
    }
    @Test void shortScenesReportInsufficientSamplesAndMissingCalibrationHonestly() {
        var shortText = report("窗外下雨了。");
        assertEquals(QualityMetricResult.Status.INSUFFICIENT_DATA,metric(shortText,"opening_collision").status());
        assertNull(metric(shortText,"skeleton_reuse").value());
        var longer = report("她看向窗外，雨還在下。".repeat(12));
        assertEquals(QualityMetricResult.Status.UNCALIBRATED,metric(longer,"rhythm_predictability").status());
        assertNull(metric(longer,"formulaic_bias").value());
        assertNull(longer.statistics().wordFrequencyJsd());
    }
    @Test void everyMetricAndWindowSharesOneTokenizationWithExactEvidenceOffsets() {
        var calls = new AtomicInteger(); var actual = new JiebaTokenizer();
        ChineseTokenizer counted = (text,names) -> { calls.incrementAndGet(); return actual.tokenize(text,names); };
        String text = "𠮷野走過安靜的河邊，想起昨天的約定。".repeat(80);
        var report = new QualityAnalyzer(counted).analyze(text,defaults.withNames(Set.of("𠮷野")),QualityCalibration.empty());
        assertEquals(1,calls.get()); assertTrue(report.windows().size() > 1);
        for (var metric : report.metrics()) for (var evidence : metric.evidence())
            assertEquals(text.substring(evidence.start(),evidence.end()),evidence.text());
        assertTrue(report.statistics().mattr() > 0 && report.statistics().mattr() <= 1);
    }
}
