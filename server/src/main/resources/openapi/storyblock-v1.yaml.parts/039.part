        event_id:
          type: string
          pattern: '^sle_[0-9a-f-]{36}$'
        profile_id:
          type: string
          pattern: '^spf_[0-9a-f-]{36}$'
        version_id:
          type: string
          pattern: '^spv_[0-9a-f-]{36}$'
        sequence:
          type: integer
          minimum: 1
        from_state:
          type: [string, "null"]
          enum: [draft, calibrating, ready, deprecated, null]
        to_state:
          type: string
          enum: [draft, calibrating, ready, deprecated]
        reason:
          type: string
          minLength: 1
          maxLength: 1000
        generated_promotion_confirmed:
          type: boolean
        request_id:
          type: string
        actor_id:
          type: string
          pattern: '^[A-Za-z0-9._:@-]{1,128}$'
        actor_key_id:
          type: [string, "null"]
          pattern: '^key_[0-9a-f-]{36}$'
        occurred_at:
          type: string
          format: date-time
      additionalProperties: false
    StyleProfileVersionView:
      type: object
      required: [profile_version, lifecycle, state, approved_by, approved_at, can_gate_rewrites]
      properties:
        profile_version:
          $ref: "#/components/schemas/StyleProfileVersion"
        lifecycle:
          type: array
          minItems: 1
          items:
            $ref: "#/components/schemas/StyleLifecycleEvent"
        state:
          type: string
          enum: [draft, calibrating, ready, deprecated]
        approved_by:
          type: [string, "null"]
          pattern: '^[A-Za-z0-9._:@-]{1,128}$'
        approved_at:
          type: [string, "null"]
          format: date-time
        can_gate_rewrites:
          type: boolean
      additionalProperties: false
