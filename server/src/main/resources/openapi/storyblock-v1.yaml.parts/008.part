      operationId: getStyleAnalysis
      summary: Get durable style analysis state and result metadata
      x-required-scopes: ["novel:read"]
      parameters:
        - $ref: "#/components/parameters/AnalysisId"
      responses:
        "200":
          description: Analysis state and canonical result metadata
          headers:
            ETag:
              $ref: "#/components/headers/StrongEtag"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StyleAnalysisView"
        default:
          $ref: "#/components/responses/Problem"
  /style-analyses/{analysisId}/windows:
    get:
      operationId: listStyleAnalysisWindows
      summary: Page canonical window findings for a completed style analysis
      x-required-scopes: ["novel:read"]
      parameters:
        - $ref: "#/components/parameters/AnalysisId"
        - $ref: "#/components/parameters/Cursor"
        - $ref: "#/components/parameters/PageLimit"
      responses:
        "200":
          description: One stable cursor page of operational window findings
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StyleAnalysisWindowPage"
        default:
          $ref: "#/components/responses/Problem"
  /rewrite-proposals:
    post:
      operationId: startRewriteProposal
      summary: Reserve an immutable rewrite candidate and worker input
      x-required-scopes: ["rewrite:propose"]
      parameters:
        - $ref: "#/components/parameters/IfMatch"
        - $ref: "#/components/parameters/IdempotencyKey"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/RewriteProposalRequest"
      responses:
        "202":
          description: Rewrite candidate reserved
          headers:
            Location:
              $ref: "#/components/headers/Location"
            ETag:
              $ref: "#/components/headers/StrongEtag"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/RewriteProposalAccepted"
        default:
          $ref: "#/components/responses/Problem"
  /rewrite-proposals/{proposalId}:
    get:
