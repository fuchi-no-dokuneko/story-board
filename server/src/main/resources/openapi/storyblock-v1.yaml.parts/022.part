    ImportRequest:
      type: object
      required: [format, document]
      properties:
        format:
          type: string
          enum: [canonical-revision, canonical-package]
        document:
          oneOf:
            - $ref: "#/components/schemas/CanonicalRevision"
            - $ref: "#/components/schemas/CanonicalPackage"
      additionalProperties: false
    AdminNovelSummary:
      type: object
      required: [agent_write_registered, block_count, chapter_count, han_character_count, han_text_sha256, head_hash, head_revision_id, head_sequence, language, main_characters, novel_id, scene_count, title, tnt_cannon_count, updated_at, zombie_count]
      properties:
        agent_write_registered:
          type: boolean
        block_count:
          type: integer
          minimum: 0
        chapter_count:
          type: integer
          minimum: 0
        han_character_count:
          type: integer
          minimum: 0
        han_text_sha256:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        head_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        head_revision_id:
          type: string
          pattern: '^rev_[A-Za-z0-9]{5}$'
        head_sequence:
          type: integer
          minimum: 0
        language:
          type: string
        main_characters:
          type: array
          maxItems: 5
          items:
            type: string
        novel_id:
          type: string
          pattern: '^nov_[A-Za-z0-9]{5}$'
        scene_count:
          type: integer
          minimum: 0
        title:
          type: string
        tnt_cannon_count:
          type: integer
          minimum: 0
        updated_at:
          type: string
          format: date-time
        zombie_count:
          type: integer
          minimum: 0
      additionalProperties: false
    AdminNovelCatalog:
      type: object
      required: [items, page, schema_version, size, total, total_pages]
      properties:
        items:
          type: array
          items:
            $ref: "#/components/schemas/AdminNovelSummary"
        page:
          type: integer
          minimum: 0
        schema_version:
          const: admin-novel-reader-1.0.0
        size:
          type: integer
          minimum: 1
          maximum: 100
        total:
          type: integer
          minimum: 0
        total_pages:
          type: integer
          minimum: 0
      additionalProperties: false
    AdminNovelDetail:
      type: object
      required: [novel, revision, schema_version]
      properties:
        novel:
          $ref: "#/components/schemas/AdminNovelSummary"
        revision:
          $ref: "#/components/schemas/CanonicalRevision"
        schema_version:
