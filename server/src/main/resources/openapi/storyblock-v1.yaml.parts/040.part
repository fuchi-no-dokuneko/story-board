          maxLength: 1000
        confirm_generated_corpus_promotion:
          type: boolean
          description: Must be true when promoting generated or mixed corpus to READY.
      additionalProperties: false
    StyleChannelDistance:
      type: object
      required: [channel, channel_version, primary_metric, primary_distance, independent_gate_evidence, diagnostics]
      properties:
        channel:
          type: string
          enum: [surface, grammar, rhythm, narrative, lexical, optional_embedding]
        channel_version:
          type: string
        primary_metric:
          type: string
          enum: [jensen_shannon_distance, wasserstein_distance, robust_l1_input, cosine_distance]
        primary_distance:
          type: number
          minimum: 0
        independent_gate_evidence:
          type: boolean
        diagnostics:
          type: object
          additionalProperties: true
      additionalProperties: false
    StyleDistanceReport:
      type: object
      required: [contract_hash, target_feature_set_hash, current_feature_set_hash, channels, token_kl_diagnostic_only]
      properties:
        contract_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        target_feature_set_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        current_feature_set_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        channels:
          type: array
          minItems: 5
          maxItems: 6
          items:
            $ref: "#/components/schemas/StyleChannelDistance"
        token_kl_diagnostic_only:
          const: true
      additionalProperties: false
    StyleProfileSelection:
      type: object
      required: [requested_stratum, selected_stratum, reason, calibration_available, confidence]
      properties:
        requested_stratum:
          $ref: "#/components/schemas/StyleStratum"
        selected_stratum:
          $ref: "#/components/schemas/StyleStratum"
        reason:
          type: string
          enum: [exact, speaker_fallback, unavailable]
        calibration_available:
          type: boolean
        confidence:
          type: string
          enum: [calibrated, low_confidence]
      additionalProperties: false
    StyleCalibratedChannelScore:
      type: object
      required: [distance, percentile, robust_z, q95, q99, above_q95, above_q99]
      properties:
        distance:
          $ref: "#/components/schemas/StyleChannelDistance"
        percentile:
          type: number
          minimum: 0
          maximum: 100
        robust_z:
          type: number
          minimum: 0
        q95:
          type: number
          minimum: 0
        q99:
          type: number
          minimum: 0
        above_q95:
