          type: string
        format:
          type: string
          enum: [canonical-revision, canonical-package]
      additionalProperties: false
    AccessKeyRequest:
      type: object
      required: [actor_id, scopes, expires_at]
      properties:
        actor_id:
          type: string
          pattern: '^[A-Za-z0-9._:@-]{1,128}$'
        scopes:
          type: array
          minItems: 1
          uniqueItems: true
          items:
            type: string
            enum: [novel:read, novel:analyze, novel:propose, novel:commit, novel:admin, style:analyze, style:admin, rewrite:propose, monitor:submit, worker:execute]
        expires_at:
          type: string
          format: date-time
      additionalProperties: false
    AccessKeyCreated:
      type: object
      required: [key_id, novel_id, actor_id, scopes, expires_at, secret]
      properties:
        key_id:
          type: string
          pattern: '^key_[0-9a-f-]{36}$'
        novel_id:
          type: string
          pattern: '^nov_[A-Za-z0-9]{5}$'
        actor_id:
          type: string
          pattern: '^[A-Za-z0-9._:@-]{1,128}$'
        scopes:
          type: array
          items:
            type: string
            enum: [novel:read, novel:analyze, novel:propose, novel:commit, novel:admin, style:analyze, style:admin, rewrite:propose, monitor:submit, worker:execute]
        expires_at:
          type: string
          format: date-time
        secret:
          type: string
          pattern: '^nv_key_[0-9a-f-]{36}\.[A-Za-z0-9_-]{43}$'
          readOnly: true
          description: One-time bearer credential; the response must not be cached.
      additionalProperties: false
    RevokeResponse:
      type: object
      required: [key_id, revoked]
      properties:
        key_id:
          type: string
          pattern: '^key_[0-9a-f-]{36}$'
        revoked:
          type: boolean
      additionalProperties: false
    WorkerClaimRequest:
      type: object
      required: [novel_id, lease_owner, lease_seconds]
      properties:
        novel_id:
          type: string
          pattern: '^nov_[A-Za-z0-9]{5}$'
        lease_owner:
          type: string
          pattern: '^[A-Za-z0-9._:@-]{1,128}$'
        lease_seconds:
          type: integer
          minimum: 15
          maximum: 1800
      additionalProperties: false
    WorkerClaimResponse:
      type: object
      required: [analysis_id, attempt, idempotent_replay, job_id, lease_owner, lease_until, retention_until, snapshot, status_hash]
      properties:
        analysis_id:
          type: string
          pattern: '^ana_[0-9a-f-]{36}$'
        attempt:
          type: integer
          minimum: 1
          maximum: 20
        idempotent_replay:
          type: boolean
        job_id:
