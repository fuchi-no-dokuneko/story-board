      responses:
        "200":
          description: Durable job state
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Job"
        default:
          $ref: "#/components/responses/Problem"
  /artifacts/{artifactId}:
    get:
      operationId: downloadArtifact
      summary: Download a novel-scoped immutable result artifact
      x-required-scopes: ["novel:read"]
      parameters:
        - $ref: "#/components/parameters/ArtifactId"
      responses:
        "200":
          description: Immutable artifact bytes
          headers:
            ETag:
              $ref: "#/components/headers/StrongEtag"
            X-Artifact-Codec:
              $ref: "#/components/headers/ArtifactCodec"
            Content-Disposition:
              $ref: "#/components/headers/ContentDisposition"
          content:
            application/vnd.storyblock.package+json:
              schema:
                type: string
                format: binary
            application/vnd.storyblock.revision+json:
              schema:
                type: string
                format: binary
            application/vnd.storyblock.style-trace+json:
              schema:
                type: string
                format: binary
            image/png:
              schema:
                type: string
                format: binary
            image/jpeg:
              schema:
                type: string
                format: binary
            application/pdf:
              schema:
                type: string
                format: binary
            application/octet-stream:
              schema:
                type: string
                format: binary
        default:
          $ref: "#/components/responses/Problem"
  /novels/{novelId}/exports:
    post:
      operationId: startExport
      summary: Submit a canonical JSON or package export job
      x-required-scopes: ["novel:read"]
      parameters:
        - $ref: "#/components/parameters/NovelId"
        - $ref: "#/components/parameters/IfMatch"
        - $ref: "#/components/parameters/IdempotencyKey"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ExportRequest"
      responses:
        "202":
          $ref: "#/components/responses/JobAccepted"
        default:
          $ref: "#/components/responses/Problem"
  /novels/{novelId}/access-keys:
    post:
      operationId: createAccessKey
      summary: Issue a scoped per-novel bearer credential
      x-required-scopes: ["novel:admin"]
      parameters:
        - $ref: "#/components/parameters/NovelId"
        - $ref: "#/components/parameters/IfMatch"
