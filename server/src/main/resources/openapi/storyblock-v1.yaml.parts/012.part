        - $ref: "#/components/parameters/IdempotencyKey"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/AccessKeyRequest"
      responses:
        "201":
          description: Credential issued; secret is returned only once
          headers:
            Cache-Control:
              description: Prevent storage of the one-time credential response.
              schema:
                const: no-store
            Pragma:
              description: Legacy cache prevention for the one-time credential response.
              schema:
                const: no-cache
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/AccessKeyCreated"
        default:
          $ref: "#/components/responses/Problem"
  /access-keys/{keyId}:
    delete:
      operationId: revokeAccessKey
      summary: Revoke a scoped bearer credential
      x-required-scopes: ["novel:admin"]
      parameters:
        - $ref: "#/components/parameters/KeyId"
        - $ref: "#/components/parameters/IfMatch"
        - $ref: "#/components/parameters/IdempotencyKey"
      responses:
        "200":
          description: Key is revoked or was already revoked idempotently
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/RevokeResponse"
        default:
          $ref: "#/components/responses/Problem"
  /internal/jobs/claims:
    post:
      operationId: claimWorkerJob
      summary: Claim one available or expired durable worker lease
      x-required-scopes: ["worker:execute"]
      parameters:
        - $ref: "#/components/parameters/IfMatchForCreation"
        - $ref: "#/components/parameters/IdempotencyKey"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/WorkerClaimRequest"
      responses:
        "200":
          description: Claimed style analysis lease and immutable execution snapshot
          headers:
            ETag:
              $ref: "#/components/headers/StrongEtag"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/WorkerClaimResponse"
        "204":
          description: No queued or expired style analysis job is available
        default:
          $ref: "#/components/responses/Problem"
  /internal/jobs/{jobId}/results:
    post:
      operationId: submitWorkerResult
      summary: Submit an idempotent version-bound worker result
      x-required-scopes: ["worker:execute"]
      parameters:
        - $ref: "#/components/parameters/JobId"
        - $ref: "#/components/parameters/IfMatch"
