      maxItems: 16
      items:
        $ref: "#/components/schemas/MonitorEvidence"
    MonitorEvidence:
      type: object
      required: [block_id, start_grapheme, end_grapheme, quote, quote_hash]
      properties:
        block_id:
          type: string
          pattern: '^blk_[A-Za-z0-9]{5}$'
        start_grapheme:
          type: integer
          minimum: 0
        end_grapheme:
          type: integer
          minimum: 1
        quote:
          type: string
          minLength: 1
        quote_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
      additionalProperties: false
    MonitorRunStatus:
      type: object
      required: [monitor_run_id, output_id, output_kind, novel_id, revision_id, revision_hash, target_block_id, neighbor_count, monitor_version, rule_version, affected_blocks, output, request_hash, submitted_at, state, stale_reasons, rebase_allowed]
      properties:
        monitor_run_id:
          type: string
          pattern: '^mrun_[0-9a-f-]{36}$'
        output_id:
          type: string
          pattern: '^(mis|mpr)_[0-9a-f-]{36}$'
        output_kind:
          type: string
          enum: [finding, proposed_operation]
        novel_id:
          type: string
          pattern: '^nov_[A-Za-z0-9]{5}$'
        revision_id:
          type: string
          pattern: '^rev_[A-Za-z0-9]{5}$'
        revision_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        target_block_id:
          type: string
          pattern: '^blk_[A-Za-z0-9]{5}$'
        neighbor_count:
          type: integer
          minimum: 1
          maximum: 2
        monitor_version:
          type: string
        rule_version:
          type: string
        affected_blocks:
          type: array
          minItems: 1
          maxItems: 5
          uniqueItems: true
          items:
            $ref: "#/components/schemas/MonitorBlockFingerprint"
        output:
          oneOf:
            - $ref: "#/components/schemas/MonitorFindingOutput"
            - $ref: "#/components/schemas/MonitorProposedOperationOutput"
        request_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        submitted_at:
          type: string
          format: date-time
        state:
          type: string
          enum: [current, stale]
        stale_reasons:
          type: array
          uniqueItems: true
          items:
            type: string
            enum: [head_changed, affected_block_changed, affected_block_missing, rule_version_changed]
        rebase_allowed:
          const: false
        idempotent_replay:
          type: boolean
      additionalProperties: false
    MonitorSubmissionResponse:
      allOf:
        - $ref: "#/components/schemas/MonitorRunStatus"
