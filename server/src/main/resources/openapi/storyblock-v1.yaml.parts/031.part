            $ref: "#/components/schemas/StyleChannelCalibration"
      additionalProperties: false
    StyleCalibrationProfile:
      type: object
      required: [calibration_schema_version, target_corpus_hash, contract_hash, window_configuration_hash, strata]
      properties:
        calibration_schema_version:
          const: style-calibration-1.0.0
        target_corpus_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        contract_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        window_configuration_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        strata:
          type: array
          minItems: 1
          items:
            $ref: "#/components/schemas/StyleStratumCalibration"
      additionalProperties: false
    StyleProfileVersionContent:
      type: object
      required: [scope, corpus_sources, feature_set, window_configuration, calibration_statistics]
      properties:
        scope:
          $ref: "#/components/schemas/StyleProfileScope"
        corpus_sources:
          type: array
          minItems: 1
          maxItems: 1000
          items:
            $ref: "#/components/schemas/StyleCorpusSource"
        feature_set:
          $ref: "#/components/schemas/StyleFeatureSet"
        window_configuration:
          $ref: "#/components/schemas/StyleWindowConfiguration"
        calibration_statistics:
          oneOf:
            - type: object
              maxProperties: 0
            - $ref: "#/components/schemas/StyleCalibrationProfile"
      additionalProperties: false
    StyleProfileVersion:
      type: object
      required: [version_id, profile_id, version, content, created_by, created_at]
      properties:
        version_id:
          type: string
          pattern: '^spv_[0-9a-f-]{36}$'
        profile_id:
          type: string
          pattern: '^spf_[0-9a-f-]{36}$'
        version:
          type: integer
          minimum: 1
        content:
          $ref: "#/components/schemas/StyleProfileVersionContent"
        created_by:
          type: string
          pattern: '^[A-Za-z0-9._:@-]{1,128}$'
        created_at:
          type: string
          format: date-time
      additionalProperties: false
    StyleLifecycleEvent:
      type: object
      required: [event_id, profile_id, version_id, sequence, from_state, to_state, reason, generated_promotion_confirmed, request_id, actor_id, actor_key_id, occurred_at]
      properties:
        event_id:
          type: string
          pattern: '^sle_[0-9a-f-]{36}$'
        profile_id:
          type: string
          pattern: '^spf_[0-9a-f-]{36}$'
        version_id:
          type: string
          pattern: '^spv_[0-9a-f-]{36}$'
        sequence:
          type: integer
