        - type: object
          required: [idempotent_replay]
          properties:
            idempotent_replay:
              type: boolean
    StyleAnalysisRequest:
      type: object
      required: [revision_id, profile_id, profile_version_id]
      properties:
        revision_id:
          type: string
          pattern: '^rev_[A-Za-z0-9]{5}$'
        profile_id:
          type: string
          pattern: '^spf_[0-9a-f-]{36}$'
        profile_version_id:
          type: string
          pattern: '^spv_[0-9a-f-]{36}$'
        from_block_id:
          type: [string, "null"]
          pattern: '^blk_[A-Za-z0-9]{5}$'
        to_block_id:
          type: [string, "null"]
          pattern: '^blk_[A-Za-z0-9]{5}$'
        masking_lexicon:
          $ref: "#/components/schemas/StyleMaskingLexicon"
        max_attempts:
          type: integer
          minimum: 1
          maximum: 20
          default: 3
        retention_days:
          type: integer
          minimum: 1
          maximum: 365
          default: 30
      additionalProperties: false
    StyleAnalysisAccepted:
      type: object
      required: [analysis_id, analysis_uri, idempotent_replay, job_id, status, status_uri]
      properties:
        analysis_id:
          type: string
          pattern: '^ana_[0-9a-f-]{36}$'
        analysis_uri:
          type: string
          format: uri-reference
        idempotent_replay:
          type: boolean
        job_id:
          type: string
          pattern: '^job_[0-9a-f-]{36}$'
        status:
          const: queued
        status_uri:
          type: string
          format: uri-reference
      additionalProperties: false
    StyleMaskingLexicon:
      type: object
      required: [names, places]
      properties:
        names:
          type: array
          uniqueItems: true
          items:
            type: string
            minLength: 1
            maxLength: 128
        places:
          type: array
          uniqueItems: true
          items:
            type: string
            minLength: 1
            maxLength: 128
      additionalProperties: false
    RewriteProposalRequest:
      type: object
      required: [analysis_id, novel_id, revision_id, revision_hash, finding_ids]
      properties:
        analysis_id:
          type: string
          pattern: '^ana_[0-9a-f-]{36}$'
        novel_id:
          type: string
          pattern: '^nov_[A-Za-z0-9]{5}$'
        revision_id:
          type: string
          pattern: '^rev_[A-Za-z0-9]{5}$'
        revision_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        finding_ids:
          type: array
          minItems: 1
          maxItems: 64
          uniqueItems: true
          items:
            type: string
