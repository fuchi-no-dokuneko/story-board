          minimum: 1
        from_state:
          type: [string, "null"]
          enum: [draft, calibrating, ready, deprecated, null]
        to_state:
          type: string
          enum: [draft, calibrating, ready, deprecated]
        reason:
          type: string
          minLength: 1
          maxLength: 1000
        generated_promotion_confirmed:
          type: boolean
        request_id:
          type: string
        actor_id:
          type: string
          pattern: '^[A-Za-z0-9._:@-]{1,128}$'
        actor_key_id:
          type: [string, "null"]
          pattern: '^key_[0-9a-f-]{36}$'
        occurred_at:
          type: string
          format: date-time
      additionalProperties: false
    StyleProfileVersionView:
      type: object
      required: [profile_version, lifecycle, state, approved_by, approved_at, can_gate_rewrites]
      properties:
        profile_version:
          $ref: "#/components/schemas/StyleProfileVersion"
        lifecycle:
          type: array
          minItems: 1
          items:
            $ref: "#/components/schemas/StyleLifecycleEvent"
        state:
          type: string
          enum: [draft, calibrating, ready, deprecated]
        approved_by:
          type: [string, "null"]
          pattern: '^[A-Za-z0-9._:@-]{1,128}$'
        approved_at:
          type: [string, "null"]
          format: date-time
        can_gate_rewrites:
          type: boolean
      additionalProperties: false
    StyleProfileTransitionRequest:
      type: object
      required: [target_state, reason, confirm_generated_corpus_promotion]
      properties:
        target_state:
          type: string
          enum: [calibrating, ready, deprecated]
        reason:
          type: string
          minLength: 1
          maxLength: 1000
        confirm_generated_corpus_promotion:
          type: boolean
          description: Must be true when promoting generated or mixed corpus to READY.
      additionalProperties: false
    StyleChannelDistance:
      type: object
      required: [channel, channel_version, primary_metric, primary_distance, independent_gate_evidence, diagnostics]
      properties:
        channel:
          type: string
          enum: [surface, grammar, rhythm, narrative, lexical, optional_embedding]
        channel_version:
          type: string
        primary_metric:
          type: string
          enum: [jensen_shannon_distance, wasserstein_distance, robust_l1_input, cosine_distance]
        primary_distance:
          type: number
          minimum: 0
        independent_gate_evidence:
          type: boolean
        diagnostics:
          type: object
          additionalProperties: true
      additionalProperties: false
    StyleDistanceReport:
      type: object
