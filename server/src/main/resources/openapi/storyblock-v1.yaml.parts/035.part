        can_trigger_rewrite:
          type: boolean
        confidence:
          type: string
          enum: [calibrated, low_confidence]
        decision_state:
          type: string
          enum: [normal, warning, rewrite_candidate, topic_shift_only, low_confidence]
        ordinal:
          type: integer
          minimum: 0
          maximum: 999
        payload:
          type: object
          additionalProperties: true
        window_id:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
      additionalProperties: false
    StyleAnalysisWindowPage:
      type: object
      required: [analysis_id, items, next_cursor]
      properties:
        analysis_id:
          type: string
          pattern: '^ana_[0-9a-f-]{36}$'
        items:
          type: array
          maxItems: 200
          items:
            $ref: "#/components/schemas/StyleAnalysisWindowFinding"
        next_cursor:
          type: [string, "null"]
          maxLength: 256
      additionalProperties: false
    RewriteProposal:
      type: object
      required: [proposal_id, novel_id, revision_id, revision_hash, diff, scores, validator_result, status]
      properties:
        proposal_id:
          type: string
        novel_id:
          type: string
        revision_id:
          type: string
        revision_hash:
          type: string
        diff:
          type: object
        scores:
          type: object
        validator_result:
          type: object
        status:
          type: string
          enum: [pending, ready, stale, expired, rejected]
      additionalProperties: false
    StyleProfileRequest:
      type: object
      required: [name, scope, provenance]
      properties:
        name:
          type: string
          minLength: 1
          maxLength: 200
        scope:
          $ref: "#/components/schemas/StyleProfileScope"
        provenance:
          type: string
          minLength: 1
          maxLength: 2000
      additionalProperties: false
    StyleProfileScope:
      type: object
      required: [novel_id, kind, subject_id]
      properties:
        novel_id:
          type: string
          pattern: '^nov_[A-Za-z0-9]{5}$'
        kind:
          type: string
          enum: [novel, series, character]
        subject_id:
          type: [string, "null"]
          pattern: '^[A-Za-z0-9._:@-]{1,128}$'
      additionalProperties: false
    StyleProfile:
      type: object
      required: [profile_id, name, scope, provenance, created_by, created_at]
      properties:
        profile_id:
          type: string
          pattern: '^spf_[0-9a-f-]{36}$'
        name:
          type: string
        scope:
          $ref: "#/components/schemas/StyleProfileScope"
        provenance:
          type: string
        created_by:
