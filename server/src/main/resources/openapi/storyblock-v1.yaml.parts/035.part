            enum: [novel:read, novel:analyze, novel:propose, novel:commit, novel:admin, style:analyze, style:admin, rewrite:propose, monitor:submit, worker:execute]
        expires_at:
          type: string
          format: date-time
        secret:
          type: string
          pattern: '^nv_key_[0-9a-f-]{36}\.[A-Za-z0-9_-]{43}$'
          readOnly: true
          description: One-time bearer credential; the response must not be cached.
      additionalProperties: false
    RevokeResponse:
      type: object
      required: [key_id, revoked]
      properties:
        key_id:
          type: string
          pattern: '^key_[0-9a-f-]{36}$'
        revoked:
          type: boolean
      additionalProperties: false
    WorkerClaimRequest:
      type: object
      required: [novel_id, lease_owner, lease_seconds]
      properties:
        novel_id:
          type: string
          pattern: '^nov_[0-9a-f-]{36}$'
        lease_owner:
          type: string
          pattern: '^[A-Za-z0-9._:@-]{1,128}$'
        lease_seconds:
          type: integer
          minimum: 15
          maximum: 1800
      additionalProperties: false
    WorkerClaimResponse:
      type: object
      required: [analysis_id, attempt, idempotent_replay, job_id, lease_owner, lease_until, retention_until, snapshot, status_hash]
      properties:
        analysis_id:
          type: string
          pattern: '^ana_[0-9a-f-]{36}$'
        attempt:
          type: integer
          minimum: 1
          maximum: 20
        idempotent_replay:
          type: boolean
        job_id:
          type: string
          pattern: '^job_[0-9a-f-]{36}$'
        lease_owner:
          type: string
          pattern: '^[A-Za-z0-9._:@-]{1,128}$'
        lease_until:
          type: string
          format: date-time
        retention_until:
          type: string
          format: date-time
        snapshot:
          $ref: "#/components/schemas/StyleAnalysisSnapshot"
        status_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
      additionalProperties: false
    StyleAnalysisSnapshot:
      type: object
      required: [blocks, masking_lexicon, novel_id, profile_version, revision_hash, revision_id]
      properties:
        blocks:
          type: array
          minItems: 1
          maxItems: 1000
          items:
            $ref: "#/components/schemas/StyleAnalysisBlock"
        masking_lexicon:
          $ref: "#/components/schemas/StyleMaskingLexicon"
        novel_id:
          type: string
          pattern: '^nov_[0-9a-f-]{36}$'
        profile_version:
          $ref: "#/components/schemas/StyleProfileVersion"
        revision_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        revision_id:
          type: string
