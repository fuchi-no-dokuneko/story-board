openapi: 3.1.0
info:
  title: StoryBlock Engine API
  version: 1.1.0
  description: Immutable, evidence-bound narrative editing contracts.
servers:
  - url: /v1
security:
  - bearerAuth: []
x-http-status-policy:
  "200": Synchronous read, preview, worker result, or idempotent result
  "201": Novel, profile, key, monitor output, or canonical revision created
  "202": Durable analysis, rewrite, or export job accepted
  "400": Malformed JSON, header, cursor, or request contract
  "401": Authentication is missing or invalid
  "403": Authenticated principal lacks the required scope
  "404": Resource does not exist or is not visible
  "409": Idempotency payload or operation state conflicts
  "410": Proposal or retained artifact has expired
  "412": If-Match does not identify the current head
  "413": Request, batch, or artifact exceeds its configured limit
  "422": Deterministic validation rejected the request
  "428": If-Match or Idempotency-Key is missing
  "429": Rate or concurrency limit exceeded
  "503": Storage or worker dependency is unavailable
paths:
  /admin/novels:
    get:
      operationId: listAdminNovels
      summary: List persisted novels for the read-only admin library
      x-required-role: operator
      parameters:
        - name: page
          in: query
          required: false
          schema:
            type: integer
            minimum: 0
            default: 0
        - name: size
          in: query
          required: false
          schema:
            type: integer
            minimum: 1
            maximum: 100
            default: 25
        - name: q
          in: query
          required: false
          schema:
            type: string
            maxLength: 200
            default: ""
      responses:
        "200":
          description: Page of current persisted novel heads
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/AdminNovelCatalog"
        default:
          $ref: "#/components/responses/Problem"
  /admin/novels/{novelId}:
    get:
      operationId: readAdminNovel
      summary: Read a persisted novel and its current canonical revision
      x-required-role: operator
      parameters:
        - $ref: "#/components/parameters/NovelId"
      responses:
        "200":
          description: Current persisted novel and complete readable revision
          headers:
            ETag:
              $ref: "#/components/headers/StrongEtag"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/AdminNovelDetail"
        default:
          $ref: "#/components/responses/Problem"
  /agent/novels:
    post:
      operationId: registerAgentNovel
