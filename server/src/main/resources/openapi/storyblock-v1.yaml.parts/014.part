          description: Available server-side reference styles. Registry errors are
            explicit.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/StyleList'
        default:
          $ref: '#/components/responses/Problem'
  /novels/{novelId}/style-comparisons:
    post:
      operationId: novels_style-comparisons_create
      x-required-scopes: ["style:analyze"]
      summary: Fresh uncached comparison returned after background calculation; no
        task identifier or polling.
      parameters:
      - name: novelId
        required: true
        schema:
          type: string
          pattern: ^nov_[A-Za-z0-9]{5}$
        in: path
      - $ref: '#/components/parameters/IfMatch'
      - $ref: '#/components/parameters/IdempotencyKey'
      responses:
        '200':
          description: Fresh uncached comparison returned after background calculation;
            no task identifier or polling.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/StyleComparisonResponse'
        default:
          $ref: '#/components/responses/Problem'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/StyleComparisonRequest'
  /novels/{novelId}/quality-reports:
    post:
      operationId: novels_quality-reports_create
      x-required-scopes: ["style:analyze"]
      summary: Independent quality indices with source evidence and reference percentiles.
      parameters:
      - name: novelId
        required: true
        schema:
          type: string
          pattern: ^nov_[A-Za-z0-9]{5}$
        in: path
      - $ref: '#/components/parameters/IfMatch'
      - $ref: '#/components/parameters/IdempotencyKey'
      responses:
        '200':
          description: Fresh uncached comparison returned after background calculation;
            no task identifier or polling.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/QualityReportResponse'
        default:
          $ref: '#/components/responses/Problem'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/QualityReportRequest'
