        type: string
  responses:
    Problem:
      description: RFC problem response with a stable machine code
      content:
        application/problem+json:
          schema:
            $ref: "#/components/schemas/Problem"
    JobAccepted:
      description: Durable job accepted
      headers:
        Location:
          $ref: "#/components/headers/Location"
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/JobAccepted"
  schemas:
    Problem:
      type: object
      required: [type, title, status, code, detail, instance, request_id]
      properties:
        type:
          type: string
          format: uri
        title:
          type: string
        status:
          type: integer
          minimum: 400
          maximum: 599
        code:
          type: string
          pattern: '^[A-Z][A-Z0-9_]{1,63}$'
        detail:
          type: string
        instance:
          type: string
        request_id:
          type: string
        current_revision_id:
          type: string
        current_etag:
          type: string
      additionalProperties: true
    CreateNovelRequest:
      type: object
      required: [initial_revision]
      properties:
        initial_revision:
          $ref: "#/components/schemas/CanonicalRevision"
      additionalProperties: false
    ImportRequest:
      type: object
      required: [format, document]
      properties:
        format:
          type: string
          enum: [canonical-revision, canonical-package]
        document:
          oneOf:
            - $ref: "#/components/schemas/CanonicalRevision"
            - $ref: "#/components/schemas/CanonicalPackage"
      additionalProperties: false
    AdminNovelSummary:
      type: object
      required: [agent_write_registered, block_count, chapter_count, han_character_count, han_text_sha256, head_hash, head_revision_id, head_sequence, language, main_characters, novel_id, scene_count, title, tnt_cannon_count, updated_at, zombie_count]
      properties:
        agent_write_registered:
          type: boolean
        block_count:
          type: integer
          minimum: 0
        chapter_count:
          type: integer
          minimum: 0
        han_character_count:
          type: integer
          minimum: 0
        han_text_sha256:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        head_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        head_revision_id:
          type: string
          pattern: '^rev_[0-9a-f-]{36}$'
        head_sequence:
          type: integer
          minimum: 0
        language:
          type: string
        main_characters:
          type: array
          maxItems: 5
          items:
            type: string
