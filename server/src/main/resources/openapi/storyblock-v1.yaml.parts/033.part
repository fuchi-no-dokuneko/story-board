      type: object
      required: [job_id, status, status_uri]
      properties:
        job_id:
          type: string
        status:
          const: queued
        status_uri:
          type: string
          format: uri-reference
      additionalProperties: false
    Job:
      oneOf:
        - $ref: "#/components/schemas/ExportJob"
        - $ref: "#/components/schemas/StyleAnalysisJob"
    ExportJob:
      type: object
      required: [job_id, novel_id, revision_id, kind, status, attempt, result_artifact_id, result_uri, created_at, updated_at]
      properties:
        job_id:
          type: string
          pattern: '^job_[0-9a-f-]{36}$'
        novel_id:
          type: string
          pattern: '^nov_[A-Za-z0-9]{5}$'
        revision_id:
          type: string
          pattern: '^rev_[A-Za-z0-9]{5}$'
        kind:
          const: canonical-export
        status:
          const: succeeded
        attempt:
          const: 1
        result_artifact_id:
          type: string
          pattern: '^art_[0-9a-f-]{36}$'
        result_uri:
          type: string
          format: uri-reference
        created_at:
          type: string
          format: date-time
        updated_at:
          type: string
          format: date-time
      additionalProperties: false
    StyleAnalysisJobFields:
      type: object
      required: [analysis_id, attempt, created_at, failure_code, job_id, kind, max_attempts, novel_id, result_artifact_id, result_hash, retention_until, revision_id, status, updated_at]
      properties:
        analysis_id:
          type: string
          pattern: '^ana_[0-9a-f-]{36}$'
        attempt:
          type: integer
          minimum: 0
          maximum: 20
        created_at:
          type: string
          format: date-time
        failure_code:
          type: [string, "null"]
          pattern: '^[a-z][a-z0-9._-]{1,63}$'
        job_id:
          type: string
          pattern: '^job_[0-9a-f-]{36}$'
        kind:
          const: style-analysis
        max_attempts:
          type: integer
          minimum: 1
          maximum: 20
        novel_id:
          type: string
          pattern: '^nov_[A-Za-z0-9]{5}$'
        result_artifact_id:
          type: [string, "null"]
          pattern: '^art_[0-9a-f-]{36}$'
        result_hash:
          type: [string, "null"]
          pattern: '^sha256:[0-9a-f]{64}$'
        retention_until:
          type: string
          format: date-time
        revision_id:
          type: string
          pattern: '^rev_[A-Za-z0-9]{5}$'
        status:
          type: string
          enum: [queued, running, succeeded, failed]
        updated_at:
          type: string
          format: date-time
    StyleAnalysisJob:
      allOf:
