      required: [contract_hash, target_feature_set_hash, current_feature_set_hash, channels, token_kl_diagnostic_only]
      properties:
        contract_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        target_feature_set_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        current_feature_set_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        channels:
          type: array
          minItems: 5
          maxItems: 6
          items:
            $ref: "#/components/schemas/StyleChannelDistance"
        token_kl_diagnostic_only:
          const: true
      additionalProperties: false
    StyleProfileSelection:
      type: object
      required: [requested_stratum, selected_stratum, reason, calibration_available, confidence]
      properties:
        requested_stratum:
          $ref: "#/components/schemas/StyleStratum"
        selected_stratum:
          $ref: "#/components/schemas/StyleStratum"
        reason:
          type: string
          enum: [exact, speaker_fallback, unavailable]
        calibration_available:
          type: boolean
        confidence:
          type: string
          enum: [calibrated, low_confidence]
      additionalProperties: false
    StyleCalibratedChannelScore:
      type: object
      required: [distance, percentile, robust_z, q95, q99, above_q95, above_q99]
      properties:
        distance:
          $ref: "#/components/schemas/StyleChannelDistance"
        percentile:
          type: number
          minimum: 0
          maximum: 100
        robust_z:
          type: number
          minimum: 0
        q95:
          type: number
          minimum: 0
        q99:
          type: number
          minimum: 0
        above_q95:
          type: boolean
        above_q99:
          type: boolean
      additionalProperties: false
    StyleWindowScore:
      type: object
      required: [window, profile_selection, distance_report, channels]
      properties:
        window:
          $ref: "#/components/schemas/StyleWindow"
        profile_selection:
          $ref: "#/components/schemas/StyleProfileSelection"
        distance_report:
          $ref: "#/components/schemas/StyleDistanceReport"
        channels:
          type: array
          maxItems: 6
          items:
            $ref: "#/components/schemas/StyleCalibratedChannelScore"
      additionalProperties: false
    StyleAnomalyDecision:
      type: object
      required: [state, reason, confidence, operational_window_id, independent_q99_channels, sustaining_window_ids, localized_micro_window_ids, intentional_shift_adjusted, can_trigger_rewrite]
      properties:
        state:
          type: string
