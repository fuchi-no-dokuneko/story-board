        output:
          oneOf:
            - $ref: "#/components/schemas/MonitorFindingOutput"
            - $ref: "#/components/schemas/MonitorProposedOperationOutput"
          discriminator:
            propertyName: kind
            mapping:
              finding: "#/components/schemas/MonitorFindingOutput"
              proposed_operation: "#/components/schemas/MonitorProposedOperationOutput"
      additionalProperties: false
    MonitorFindingOutput:
      type: object
      required: [kind, code, severity, message, evidence]
      properties:
        kind:
          const: finding
        code:
          type: string
          pattern: '^[A-Z][A-Z0-9_]{2,63}$'
        severity:
          type: string
          enum: [error, warning, info]
        message:
          type: string
          minLength: 1
          maxLength: 2000
        evidence:
          $ref: "#/components/schemas/MonitorEvidenceList"
      additionalProperties: false
    MonitorProposedOperationOutput:
      type: object
      required: [kind, operation, evidence]
      properties:
        kind:
          const: proposed_operation
        operation:
          $ref: "#/components/schemas/OperationEnvelope"
        evidence:
          $ref: "#/components/schemas/MonitorEvidenceList"
      additionalProperties: false
    MonitorEvidenceList:
      type: array
      minItems: 1
      maxItems: 16
      items:
        $ref: "#/components/schemas/MonitorEvidence"
    MonitorEvidence:
      type: object
      required: [block_id, start_grapheme, end_grapheme, quote, quote_hash]
      properties:
        block_id:
          type: string
          pattern: '^blk_[0-9a-f-]{36}$'
        start_grapheme:
          type: integer
          minimum: 0
        end_grapheme:
          type: integer
          minimum: 1
        quote:
          type: string
          minLength: 1
        quote_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
      additionalProperties: false
    MonitorRunStatus:
      type: object
      required: [monitor_run_id, output_id, output_kind, novel_id, revision_id, revision_hash, target_block_id, neighbor_count, monitor_version, rule_version, affected_blocks, output, request_hash, submitted_at, state, stale_reasons, rebase_allowed]
      properties:
        monitor_run_id:
          type: string
          pattern: '^mrun_[0-9a-f-]{36}$'
        output_id:
          type: string
          pattern: '^(mis|mpr)_[0-9a-f-]{36}$'
        output_kind:
          type: string
          enum: [finding, proposed_operation]
        novel_id:
          type: string
          pattern: '^nov_[0-9a-f-]{36}$'
        revision_id:
          type: string
          pattern: '^rev_[0-9a-f-]{36}$'
        revision_hash:
          type: string
