        vocabulary_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        normalizer_version:
          type: string
        additive_smoothing_alpha:
          type: number
          exclusiveMinimum: 0
          maximum: 1
        top_k:
          type: integer
          minimum: 10
          maximum: 10000
      additionalProperties: false
    StyleFeatureVector:
      type: object
      required: [channel, channel_version, contract_hash, distribution, measurements, embedding]
      properties:
        channel:
          type: string
          enum: [surface, grammar, rhythm, narrative, lexical, optional_embedding]
        channel_version:
          type: string
        contract_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        distribution:
          type: object
          additionalProperties:
            type: number
            minimum: 0
        measurements:
          type: object
          additionalProperties:
            type: number
        embedding:
          type: array
          maxItems: 4096
          items:
            type: number
      additionalProperties: false
    StyleFeatureSet:
      type: object
      required: [source_hash, contract, channels]
      properties:
        source_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        contract:
          $ref: "#/components/schemas/StyleFeatureContract"
        channels:
          type: array
          minItems: 5
          maxItems: 6
          items:
            $ref: "#/components/schemas/StyleFeatureVector"
      additionalProperties: false
    StyleWindowConfiguration:
      type: object
      required: [operational_graphemes, operational_stride_graphemes, micro_graphemes, micro_stride_graphemes, non_overlap_enabled]
      properties:
        operational_graphemes:
          type: integer
          minimum: 2000
          maximum: 4000
        operational_stride_graphemes:
          type: integer
          minimum: 1
          maximum: 4000
        micro_graphemes:
          type: integer
          minimum: 500
          maximum: 1000
        micro_stride_graphemes:
          type: integer
          minimum: 1
          maximum: 1000
        non_overlap_enabled:
          type: boolean
      additionalProperties: false
    StyleStratum:
      type: object
      required: [kind, speaker_id]
      properties:
        kind:
          type: string
          enum: [narration, dialogue]
        speaker_id:
          type: [string, "null"]
          pattern: '^[A-Za-z0-9._:@-]{1,128}$'
      additionalProperties: false
    StyleWindow:
      type: object
