          type: string
          pattern: '^[A-Za-z0-9._:@-]{1,128}$'
        created_at:
          type: string
          format: date-time
      additionalProperties: false
    StyleCorpusSource:
      type: object
      required: [source_id, content_hash, kind, provenance, license, ownership]
      properties:
        source_id:
          type: string
          pattern: '^[A-Za-z0-9._:@-]{1,128}$'
        content_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        kind:
          type: string
          enum: [owner, licensed, public_domain, generated, mixed]
        provenance:
          type: string
          minLength: 1
          maxLength: 2000
        license:
          type: string
          minLength: 1
          maxLength: 500
        ownership:
          type: string
          minLength: 1
          maxLength: 500
      additionalProperties: false
    StyleFeatureContract:
      type: object
      required: [analyzer_version, feature_schema_version, tokenizer_id, vocabulary_hash, normalizer_version, additive_smoothing_alpha, top_k]
      properties:
        analyzer_version:
          type: string
        feature_schema_version:
          type: string
        tokenizer_id:
          type: string
        vocabulary_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        normalizer_version:
          type: string
        additive_smoothing_alpha:
          type: number
          exclusiveMinimum: 0
          maximum: 1
        top_k:
          type: integer
          minimum: 10
          maximum: 10000
      additionalProperties: false
    StyleFeatureVector:
      type: object
      required: [channel, channel_version, contract_hash, distribution, measurements, embedding]
      properties:
        channel:
          type: string
          enum: [surface, grammar, rhythm, narrative, lexical, optional_embedding]
        channel_version:
          type: string
        contract_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        distribution:
          type: object
          additionalProperties:
            type: number
            minimum: 0
        measurements:
          type: object
          additionalProperties:
            type: number
        embedding:
          type: array
          maxItems: 4096
          items:
            type: number
      additionalProperties: false
    StyleFeatureSet:
      type: object
      required: [source_hash, contract, channels]
      properties:
        source_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        contract:
          $ref: "#/components/schemas/StyleFeatureContract"
        channels:
          type: array
          minItems: 5
          maxItems: 6
          items:
