          pattern: '^sha256:[0-9a-f]{64}$'
        target_block_id:
          type: string
          pattern: '^blk_[0-9a-f-]{36}$'
        neighbor_count:
          type: integer
          minimum: 1
          maximum: 2
        monitor_version:
          type: string
        rule_version:
          type: string
        affected_blocks:
          type: array
          minItems: 1
          maxItems: 5
          uniqueItems: true
          items:
            $ref: "#/components/schemas/MonitorBlockFingerprint"
        output:
          oneOf:
            - $ref: "#/components/schemas/MonitorFindingOutput"
            - $ref: "#/components/schemas/MonitorProposedOperationOutput"
        request_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        submitted_at:
          type: string
          format: date-time
        state:
          type: string
          enum: [current, stale]
        stale_reasons:
          type: array
          uniqueItems: true
          items:
            type: string
            enum: [head_changed, affected_block_changed, affected_block_missing, rule_version_changed]
        rebase_allowed:
          const: false
        idempotent_replay:
          type: boolean
      additionalProperties: false
    MonitorSubmissionResponse:
      allOf:
        - $ref: "#/components/schemas/MonitorRunStatus"
        - type: object
          required: [idempotent_replay]
          properties:
            idempotent_replay:
              type: boolean
    StyleAnalysisRequest:
      type: object
      required: [revision_id, profile_id, profile_version_id]
      properties:
        revision_id:
          type: string
          pattern: '^rev_[0-9a-f-]{36}$'
        profile_id:
          type: string
          pattern: '^spf_[0-9a-f-]{36}$'
        profile_version_id:
          type: string
          pattern: '^spv_[0-9a-f-]{36}$'
        from_block_id:
          type: [string, "null"]
          pattern: '^blk_[0-9a-f-]{36}$'
        to_block_id:
          type: [string, "null"]
          pattern: '^blk_[0-9a-f-]{36}$'
        masking_lexicon:
          $ref: "#/components/schemas/StyleMaskingLexicon"
        max_attempts:
          type: integer
          minimum: 1
          maximum: 20
          default: 3
        retention_days:
          type: integer
          minimum: 1
          maximum: 365
          default: 30
      additionalProperties: false
    StyleAnalysisAccepted:
      type: object
      required: [analysis_id, analysis_uri, idempotent_replay, job_id, status, status_uri]
      properties:
        analysis_id:
          type: string
          pattern: '^ana_[0-9a-f-]{36}$'
        analysis_uri:
          type: string
          format: uri-reference
        idempotent_replay:
