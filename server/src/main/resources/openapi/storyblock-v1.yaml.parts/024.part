    SceneListItem:
      type: object
      properties:
        scene_id:
          type: string
          pattern: ^scn_[A-Za-z0-9]{5}$
        index:
          type: integer
          minimum: 0
        chapter_id:
          type: string
          pattern: ^ch_[A-Za-z0-9]{5}$
        chapter_index:
          type: integer
          minimum: 0
        title:
          type: string
        block_count:
          type: integer
          minimum: 0
        block_slice:
          $ref: '#/components/schemas/IndexSlice'
        total_text_graphemes:
          type: integer
          minimum: 0
      required:
      - scene_id
      - index
      - chapter_id
      - chapter_index
      - title
      - block_count
      - block_slice
      - total_text_graphemes
      additionalProperties: false
      title: SceneListItem
      description: Scene distribution; text length counts Unicode graphemes including
        punctuation.
      x-confidence: confirmed-from-code
      x-source:
      - server/src/main/java/dev/storyblock/api/http/NarrativeReadController.java
      examples:
      - scene_id: scn_Bb234
        index: 0
        chapter_id: ch_Aa123
        chapter_index: 0
        title: 清晨
        block_count: 1
        block_slice:
          start: 0
          end: 1
        total_text_graphemes: 5
    SceneList:
      type: object
      properties:
        novel_id:
          type: string
          pattern: ^nov_[A-Za-z0-9]{5}$
        revision_id:
          type: string
          pattern: ^rev_[A-Za-z0-9]{5}$
        revision_hash:
          type: string
          pattern: ^sha256:[0-9a-f]{64}$
        chapter_slice:
          $ref: '#/components/schemas/IndexSlice'
        scenes:
          type: array
          items:
            $ref: '#/components/schemas/SceneListItem'
      required:
      - novel_id
      - revision_id
      - revision_hash
      - chapter_slice
      - scenes
      additionalProperties: false
      title: SceneList
      description: Scenes selected by a half-open chapter index slice. No body text.
      x-confidence: confirmed-from-code
      x-source:
      - server/src/main/java/dev/storyblock/api/http/NarrativeReadController.java
      examples:
      - novel_id: nov_Ab123
        revision_id: rev_Cd456
        revision_hash: sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
        chapter_slice:
          start: 0
          end: 1
        scenes:
        - scene_id: scn_Bb234
          index: 0
          chapter_id: ch_Aa123
          chapter_index: 0
          title: 清晨
          block_count: 1
          block_slice:
            start: 0
            end: 1
          total_text_graphemes: 5
    BlockSliceItem:
      type: object
      properties:
        index:
          type: integer
