        - $ref: "#/components/schemas/StyleAnalysisJobFields"
        - type: object
          properties:
            result:
              $ref: "#/components/schemas/StyleAnalysisResult"
            trace_uri:
              type: string
              format: uri-reference
            windows_uri:
              type: string
              format: uri-reference
      unevaluatedProperties: false
    StyleAnalysisResult:
      type: object
      required: [analysis_id, completed_at, job_id, result_hash, summary, trace_artifact_id, trace_content_hash, trace_expires_at, trace_uncompressed_bytes]
      properties:
        analysis_id:
          type: string
          pattern: '^ana_[0-9a-f-]{36}$'
        completed_at:
          type: string
          format: date-time
        job_id:
          type: string
          pattern: '^job_[0-9a-f-]{36}$'
        result_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        summary:
          $ref: "#/components/schemas/StyleAnalysisSummary"
        trace_artifact_id:
          type: string
          pattern: '^art_[0-9a-f-]{36}$'
        trace_content_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        trace_expires_at:
          type: string
          format: date-time
        trace_uncompressed_bytes:
          type: integer
          minimum: 2
          maximum: 16777216
      additionalProperties: false
    StyleAnalysisSummary:
      type: object
      required: [analyzed_block_count, calibrated_window_count, decision_counts, operational_window_count]
      properties:
        analyzed_block_count:
          type: integer
          minimum: 1
          maximum: 1000
        calibrated_window_count:
          type: integer
          minimum: 0
          maximum: 1000
        decision_counts:
          type: object
          properties:
            normal: {type: integer, minimum: 0}
            warning: {type: integer, minimum: 0}
            rewrite_candidate: {type: integer, minimum: 0}
            topic_shift_only: {type: integer, minimum: 0}
            low_confidence: {type: integer, minimum: 0}
          additionalProperties: false
        operational_window_count:
          type: integer
          minimum: 0
          maximum: 1000
      additionalProperties: false
    StyleAnalysisWindowFinding:
      type: object
      required: [block_ids, can_trigger_rewrite, confidence, decision_state, ordinal, payload, window_id]
      properties:
        block_ids:
          type: array
          minItems: 1
          uniqueItems: true
          items:
            type: string
            pattern: '^blk_[A-Za-z0-9]{5}$'
        can_trigger_rewrite:
          type: boolean
        confidence:
          type: string
