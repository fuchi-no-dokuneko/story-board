          enum: [surface, grammar, rhythm, narrative, lexical, optional_embedding]
        channel_version:
          type: string
        primary_metric:
          type: string
          enum: [jensen_shannon_distance, wasserstein_distance, robust_l1_input, cosine_distance]
        reference_distances:
          type: array
          maxItems: 1000
          items:
            type: number
            minimum: 0
        median:
          type: number
          minimum: 0
        mad:
          type: number
          minimum: 0
        q95:
          type: number
          minimum: 0
        q99:
          type: number
          minimum: 0
      additionalProperties: false
    StyleStratumCalibration:
      type: object
      required: [stratum, window_count, confidence, channels]
      properties:
        stratum:
          $ref: "#/components/schemas/StyleStratum"
        window_count:
          type: integer
          minimum: 1
          maximum: 1000
        confidence:
          type: string
          enum: [calibrated, low_confidence]
        channels:
          type: array
          minItems: 5
          maxItems: 6
          items:
            $ref: "#/components/schemas/StyleChannelCalibration"
      additionalProperties: false
    StyleCalibrationProfile:
      type: object
      required: [calibration_schema_version, target_corpus_hash, contract_hash, window_configuration_hash, strata]
      properties:
        calibration_schema_version:
          const: style-calibration-1.0.0
        target_corpus_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        contract_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        window_configuration_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        strata:
          type: array
          minItems: 1
          items:
            $ref: "#/components/schemas/StyleStratumCalibration"
      additionalProperties: false
    StyleProfileVersionContent:
      type: object
      required: [scope, corpus_sources, feature_set, window_configuration, calibration_statistics]
      properties:
        scope:
          $ref: "#/components/schemas/StyleProfileScope"
        corpus_sources:
          type: array
          minItems: 1
          maxItems: 1000
          items:
            $ref: "#/components/schemas/StyleCorpusSource"
        feature_set:
          $ref: "#/components/schemas/StyleFeatureSet"
        window_configuration:
          $ref: "#/components/schemas/StyleWindowConfiguration"
        calibration_statistics:
          oneOf:
            - type: object
              maxProperties: 0
            - $ref: "#/components/schemas/StyleCalibrationProfile"
      additionalProperties: false
    StyleProfileVersion:
