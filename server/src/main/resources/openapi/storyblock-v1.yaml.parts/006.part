            schema:
              $ref: "#/components/schemas/DetectorRunRequest"
      responses:
        "200":
          description: Revision-bound detector findings
          headers:
            ETag:
              $ref: "#/components/headers/StrongEtag"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DetectorRunResponse"
        default:
          $ref: "#/components/responses/Problem"
  /novels/{novelId}/monitor-packets:
    post:
      operationId: createMonitorPacket
