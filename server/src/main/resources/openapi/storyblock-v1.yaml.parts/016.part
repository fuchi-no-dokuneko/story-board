    ChapterListItem:
      type: object
      properties:
        index:
          type: integer
          minimum: 0
        chapter_id:
          type: string
          pattern: ^ch_[A-Za-z0-9]{5}$
        title:
          type: string
        scene_count:
          type: integer
          minimum: 0
      required:
      - index
      - chapter_id
      - title
      - scene_count
      additionalProperties: false
      title: ChapterListItem
      description: Chapter metadata; does not count as reading block text.
      x-confidence: confirmed-from-code
      x-source:
      - server/src/main/java/dev/storyblock/api/http/NarrativeReadController.java
      examples:
      - index: 0
        chapter_id: ch_Aa123
        title: 第一章
        scene_count: 1
    ChapterList:
      type: object
      properties:
        novel_id:
          type: string
          pattern: ^nov_[A-Za-z0-9]{5}$
        revision_id:
          type: string
          pattern: ^rev_[A-Za-z0-9]{5}$
        revision_hash:
          type: string
          pattern: ^sha256:[0-9a-f]{64}$
        chapter_count:
          type: integer
          minimum: 0
        chapters:
          type: array
          items:
            $ref: '#/components/schemas/ChapterListItem'
      required:
      - novel_id
      - revision_id
      - revision_hash
      - chapter_count
      - chapters
      additionalProperties: false
      title: ChapterList
      description: All chapters at a fixed novel revision.
      x-confidence: confirmed-from-code
      x-source:
      - server/src/main/java/dev/storyblock/api/http/NarrativeReadController.java
      examples:
      - novel_id: nov_Ab123
        revision_id: rev_Cd456
        revision_hash: sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
        chapter_count: 1
        chapters:
        - index: 0
          chapter_id: ch_Aa123
          title: 第一章
          scene_count: 1
    SceneListItem:
      type: object
      properties:
        scene_id:
          type: string
          pattern: ^scn_[A-Za-z0-9]{5}$
        index:
          type: integer
          minimum: 0
        chapter_id:
          type: string
          pattern: ^ch_[A-Za-z0-9]{5}$
        chapter_index:
          type: integer
          minimum: 0
        title:
          type: string
        block_count:
          type: integer
          minimum: 0
        block_slice:
          $ref: '#/components/schemas/IndexSlice'
        total_text_graphemes:
          type: integer
          minimum: 0
      required:
      - scene_id
      - index
      - chapter_id
      - chapter_index
      - title
      - block_count
      - block_slice
      - total_text_graphemes
      additionalProperties: false
      title: SceneListItem
