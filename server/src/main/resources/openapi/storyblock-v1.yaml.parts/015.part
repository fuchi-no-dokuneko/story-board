      responses:
        '200':
          description: Fresh uncached comparison returned after background calculation;
            no task identifier or polling.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/QualityReportResponse'
        default:
          $ref: '#/components/responses/Problem'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/QualityReportRequest'
components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: nv_<public-key-id>.<256-bit-secret>
  parameters:
    NovelId:
      name: novelId
      in: path
      required: true
      schema:
        type: string
        pattern: '^nov_[A-Za-z0-9]{5}$'
    RevisionId:
      name: revisionId
      in: path
      required: true
      schema:
        type: string
        pattern: '^rev_[A-Za-z0-9]{5}$'
    AnalysisId:
      name: analysisId
      in: path
      required: true
      schema:
        type: string
        pattern: '^ana_[0-9a-f-]{36}$'
    ProposalId:
      name: proposalId
      in: path
      required: true
      schema:
        type: string
        pattern: '^prp_[0-9a-f-]{36}$'
    MonitorRunId:
      name: monitorRunId
      in: path
      required: true
      schema:
        type: string
        pattern: '^mrun_[0-9a-f-]{36}$'
    ProfileId:
      name: profileId
      in: path
      required: true
      schema:
        type: string
        pattern: '^spf_[0-9a-f-]{36}$'
    ProfileVersionId:
      name: versionId
      in: path
      required: true
      schema:
        type: string
        pattern: '^spv_[0-9a-f-]{36}$'
    JobId:
      name: jobId
      in: path
      required: true
      schema:
        type: string
        pattern: '^job_[0-9a-f-]{36}$'
    KeyId:
      name: keyId
      in: path
      required: true
      schema:
        type: string
        pattern: '^key_[0-9a-f-]{36}$'
    ArtifactId:
      name: artifactId
      in: path
      required: true
      schema:
        type: string
        pattern: '^art_[0-9a-f-]{36}$'
    Cursor:
      name: cursor
      in: query
      required: false
      schema:
        type: string
        minLength: 1
        maxLength: 256
    PageLimit:
      name: limit
      in: query
      required: false
      schema:
        type: integer
        minimum: 1
        maximum: 200
        default: 50
    IfMatch:
      name: If-Match
      in: header
      required: true
      description: A single quoted strong canonical SHA-256 ETag.
      schema:
        type: string
        pattern: '^"sha256:[0-9a-f]{64}"$'
    IfMatchForCreation:
      name: If-Match
      in: header
      required: true
