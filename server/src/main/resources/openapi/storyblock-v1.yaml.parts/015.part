        type: string
        pattern: '^key_[0-9a-f-]{36}$'
    ArtifactId:
      name: artifactId
      in: path
      required: true
      schema:
        type: string
        pattern: '^art_[0-9a-f-]{36}$'
    Cursor:
      name: cursor
      in: query
      required: false
      schema:
        type: string
        minLength: 1
        maxLength: 256
    PageLimit:
      name: limit
      in: query
      required: false
      schema:
        type: integer
        minimum: 1
        maximum: 200
        default: 50
    IfMatch:
      name: If-Match
      in: header
      required: true
      description: A single quoted strong canonical SHA-256 ETag.
      schema:
        type: string
        pattern: '^"sha256:[0-9a-f]{64}"$'
    IfMatchForCreation:
      name: If-Match
      in: header
      required: true
      description: Wildcard precondition for creation in a collection.
      schema:
        const: '*'
    IdempotencyKey:
      name: Idempotency-Key
      in: header
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 200
  headers:
    StrongEtag:
      description: Quoted strong ETag of the canonical revision or immutable resource view.
      required: true
      schema:
        type: string
        pattern: '^"sha256:[0-9a-f]{64}"$'
    Location:
      description: Absolute or origin-relative durable resource URI.
      required: true
      schema:
        type: string
        format: uri-reference
    ArtifactCodec:
      description: Storage encoding applied to the returned bytes.
      required: true
      schema:
        type: string
        pattern: '^[a-z][a-z0-9.-]{1,63}$'
    ContentDisposition:
      description: Attachment filename for offline use.
      required: true
      schema:
        type: string
  responses:
    Problem:
      description: RFC problem response with a stable machine code
      content:
        application/problem+json:
          schema:
            $ref: "#/components/schemas/Problem"
    JobAccepted:
      description: Durable job accepted
      headers:
        Location:
          $ref: "#/components/headers/Location"
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/JobAccepted"
  schemas:
    IndexSlice:
      type: object
      properties:
        start:
          type: integer
          minimum: 0
        end:
          type: integer
          minimum: 0
      required:
      - start
      - end
      additionalProperties: false
      title: IndexSlice
      description: Zero-based half-open index range [start,end).
      x-confidence: confirmed-from-code
      x-source:
      - server/src/main/java/dev/storyblock/api/http/NarrativeReadController.java
      examples:
      - start: 0
        end: 1
