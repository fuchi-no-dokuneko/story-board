      required: [block_id, block_version_id, content_hash]
      properties:
        block_id:
          type: string
          pattern: '^blk_[A-Za-z0-9]{5}$'
        block_version_id:
          type: string
          pattern: '^blv_[A-Za-z0-9]{5}$'
        content_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
      additionalProperties: false
    MonitorSubmissionRequest:
      type: object
      required: [revision_id, revision_hash, target_block_id, neighbor_count, rule_version, affected_block_ids, output]
      properties:
        revision_id:
          type: string
          pattern: '^rev_[A-Za-z0-9]{5}$'
        revision_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        target_block_id:
          type: string
          pattern: '^blk_[A-Za-z0-9]{5}$'
        neighbor_count:
          type: integer
          minimum: 1
          maximum: 2
        rule_version:
          type: string
        affected_block_ids:
          type: array
          minItems: 1
          maxItems: 5
          uniqueItems: true
          contains:
            type: string
          items:
            type: string
            pattern: '^blk_[A-Za-z0-9]{5}$'
        output:
          oneOf:
            - $ref: "#/components/schemas/MonitorFindingOutput"
            - $ref: "#/components/schemas/MonitorProposedOperationOutput"
          discriminator:
            propertyName: kind
            mapping:
              finding: "#/components/schemas/MonitorFindingOutput"
              proposed_operation: "#/components/schemas/MonitorProposedOperationOutput"
      additionalProperties: false
    MonitorFindingOutput:
      type: object
      required: [kind, code, severity, message, evidence]
      properties:
        kind:
          const: finding
        code:
          type: string
          pattern: '^[A-Z][A-Z0-9_]{2,63}$'
        severity:
          type: string
          enum: [error, warning, info]
        message:
          type: string
          minLength: 1
          maxLength: 2000
        evidence:
          $ref: "#/components/schemas/MonitorEvidenceList"
      additionalProperties: false
    MonitorProposedOperationOutput:
      type: object
      required: [kind, operation, evidence]
      properties:
        kind:
          const: proposed_operation
        operation:
          $ref: "#/components/schemas/OperationEnvelope"
        evidence:
          $ref: "#/components/schemas/MonitorEvidenceList"
      additionalProperties: false
    MonitorEvidenceList:
      type: array
      minItems: 1
      maxItems: 16
      items:
        $ref: "#/components/schemas/MonitorEvidence"
    MonitorEvidence:
      type: object
      required: [block_id, start_grapheme, end_grapheme, quote, quote_hash]
