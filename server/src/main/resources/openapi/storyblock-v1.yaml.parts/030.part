          type: integer
          minimum: 1
          maximum: 100
        total:
          type: integer
          minimum: 0
        total_pages:
          type: integer
          minimum: 0
      additionalProperties: false
    AdminNovelDetail:
      type: object
      required: [novel, revision, schema_version]
      properties:
        novel:
          $ref: "#/components/schemas/AdminNovelSummary"
        revision:
          $ref: "#/components/schemas/CanonicalRevision"
        schema_version:
          const: admin-novel-reader-1.0.0
      additionalProperties: false
    AgentNovelRegistrationChapter:
      type: object
      required: [title, text]
      properties:
        title:
          type: string
          minLength: 1
          maxLength: 200
        text:
          type: string
          minLength: 1
      additionalProperties: false
    AgentNovelRegistrationRequest:
      type: object
      required: [novel_id, created_at, title, language, main_characters, expected_han_characters, chapters]
      properties:
        novel_id:
          type: string
          pattern: '^nov_[A-Za-z0-9]{5}$'
        created_at:
          type: string
          format: date-time
        title:
          type: string
          minLength: 1
          maxLength: 200
        language:
          type: string
          minLength: 1
          maxLength: 32
        main_characters:
          type: array
          uniqueItems: true
          items:
            type: string
            minLength: 1
            maxLength: 80
        expected_han_characters:
          type: integer
          minimum: 0
        chapters:
          type: array
          minItems: 1
          maxItems: 100
          items:
            $ref: "#/components/schemas/AgentNovelRegistrationChapter"
      additionalProperties: false
    AgentNovelRegistrationResponse:
      type: object
      required: [idempotent_replay, novel, schema_version]
      properties:
        idempotent_replay:
          type: boolean
        novel:
          $ref: "#/components/schemas/AdminNovelSummary"
        schema_version:
          const: agent-novel-registration-1.0.0
      additionalProperties: false
    NovelHead:
      type: object
      required: [novel_id, head_revision_id, head_sequence, head_hash, schema_version]
      properties:
        novel_id:
          type: string
        head_revision_id:
          type: string
        head_sequence:
          type: integer
          minimum: 0
        head_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        schema_version:
          type: string
      additionalProperties: false
    CanonicalRevision:
      type: object
