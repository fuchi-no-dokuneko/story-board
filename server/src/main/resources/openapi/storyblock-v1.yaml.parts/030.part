      required: [window_id, kind, segment, requested_stratum, pov, narrative_mode, block_ids, grapheme_count, full_sized, intentional_style_shift_reason, localization_only, primary_decision_eligible, sustainment_eligible]
      properties:
        window_id:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        kind:
          type: string
          enum: [operational, micro, non_overlap]
        segment:
          type: integer
          minimum: 0
        requested_stratum:
          $ref: "#/components/schemas/StyleStratum"
        pov:
          type: string
        narrative_mode:
          type: string
        block_ids:
          type: array
          minItems: 1
          uniqueItems: true
          items:
            type: string
            pattern: '^blk_[0-9a-f-]{36}$'
        grapheme_count:
          type: integer
          minimum: 1
        full_sized:
          type: boolean
        intentional_style_shift_reason:
          type: [string, "null"]
          maxLength: 500
        localization_only:
          type: boolean
          description: True only for micro windows, which cannot trigger rewrites.
        primary_decision_eligible:
          type: boolean
          description: True only for full operational windows.
        sustainment_eligible:
          type: boolean
          description: True only for full non-overlap windows.
      additionalProperties: false
    StyleChannelCalibration:
      type: object
      required: [channel, channel_version, primary_metric, reference_distances, median, mad, q95, q99]
      properties:
        channel:
          type: string
          enum: [surface, grammar, rhythm, narrative, lexical, optional_embedding]
        channel_version:
          type: string
        primary_metric:
          type: string
          enum: [jensen_shannon_distance, wasserstein_distance, robust_l1_input, cosine_distance]
        reference_distances:
          type: array
          maxItems: 1000
          items:
            type: number
            minimum: 0
        median:
          type: number
          minimum: 0
        mad:
          type: number
          minimum: 0
        q95:
          type: number
          minimum: 0
        q99:
          type: number
          minimum: 0
      additionalProperties: false
    StyleStratumCalibration:
      type: object
      required: [stratum, window_count, confidence, channels]
      properties:
        stratum:
          $ref: "#/components/schemas/StyleStratum"
        window_count:
          type: integer
          minimum: 1
          maximum: 1000
        confidence:
          type: string
          enum: [calibrated, low_confidence]
        channels:
          type: array
          minItems: 5
          maxItems: 6
          items:
