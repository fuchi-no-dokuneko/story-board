        - $ref: "#/components/parameters/IdempotencyKey"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/WorkerResultRequest"
      responses:
        "200":
          description: Result accepted or returned idempotently
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/WorkerResultResponse"
        default:
          $ref: "#/components/responses/Problem"
