      schema:
        type: string
        pattern: '^mrun_[0-9a-f-]{36}$'
    ProfileId:
      name: profileId
      in: path
      required: true
      schema:
        type: string
        pattern: '^spf_[0-9a-f-]{36}$'
    ProfileVersionId:
