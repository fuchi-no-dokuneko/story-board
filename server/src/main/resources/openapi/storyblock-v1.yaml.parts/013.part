    IdempotencyKey:
      name: Idempotency-Key
      in: header
      required: true
      schema:
        type: string
        minLength: 1
        maxLength: 200
  headers:
    StrongEtag:
      description: Quoted strong ETag of the canonical revision or immutable resource view.
      required: true
      schema:
        type: string
        pattern: '^"sha256:[0-9a-f]{64}"$'
    Location:
      description: Absolute or origin-relative durable resource URI.
      required: true
      schema:
        type: string
        format: uri-reference
    ArtifactCodec:
      description: Storage encoding applied to the returned bytes.
      required: true
      schema:
        type: string
        pattern: '^[a-z][a-z0-9.-]{1,63}$'
