          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        trace_expires_at:
          type: string
          format: date-time
        trace_uncompressed_bytes:
          type: integer
          minimum: 2
          maximum: 16777216
      additionalProperties: false
    StyleAnalysisSummary:
      type: object
      required: [analyzed_block_count, calibrated_window_count, decision_counts, operational_window_count]
      properties:
        analyzed_block_count:
          type: integer
          minimum: 1
          maximum: 1000
        calibrated_window_count:
          type: integer
          minimum: 0
          maximum: 1000
        decision_counts:
          type: object
          properties:
            normal: {type: integer, minimum: 0}
            warning: {type: integer, minimum: 0}
            rewrite_candidate: {type: integer, minimum: 0}
            topic_shift_only: {type: integer, minimum: 0}
            low_confidence: {type: integer, minimum: 0}
          additionalProperties: false
        operational_window_count:
          type: integer
          minimum: 0
          maximum: 1000
      additionalProperties: false
    StyleAnalysisWindowFinding:
      type: object
      required: [block_ids, can_trigger_rewrite, confidence, decision_state, ordinal, payload, window_id]
      properties:
        block_ids:
          type: array
          minItems: 1
          uniqueItems: true
          items:
            type: string
            pattern: '^blk_[0-9a-f-]{36}$'
        can_trigger_rewrite:
          type: boolean
        confidence:
          type: string
          enum: [calibrated, low_confidence]
        decision_state:
          type: string
          enum: [normal, warning, rewrite_candidate, topic_shift_only, low_confidence]
        ordinal:
          type: integer
          minimum: 0
          maximum: 999
        payload:
          type: object
          additionalProperties: true
        window_id:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
      additionalProperties: false
    StyleAnalysisWindowPage:
      type: object
      required: [analysis_id, items, next_cursor]
      properties:
        analysis_id:
          type: string
          pattern: '^ana_[0-9a-f-]{36}$'
        items:
          type: array
          maxItems: 200
          items:
            $ref: "#/components/schemas/StyleAnalysisWindowFinding"
        next_cursor:
          type: [string, "null"]
          maxLength: 256
      additionalProperties: false
    RewriteProposal:
      type: object
      required: [proposal_id, novel_id, revision_id, revision_hash, diff, scores, validator_result, status]
      properties:
        proposal_id:
          type: string
        novel_id:
          type: string
