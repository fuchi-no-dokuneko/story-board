          $ref: "#/components/schemas/ResolvedMetadataState"
        state_out:
          $ref: "#/components/schemas/ResolvedMetadataState"
      additionalProperties: false
    OperationEnvelope:
      type: object
      required: [operation_id, idempotency_key, novel_id, base_revision_id, expected_head_hash, type, payload]
      properties:
        operation_id:
          type: string
        idempotency_key:
          type: string
          minLength: 1
          maxLength: 200
        novel_id:
          type: string
        base_revision_id:
          type: string
        expected_head_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        type:
          type: string
          enum: [insert_blocks, replace_block_range, delete_block_range, split_block, merge_blocks, extend_block, move_block_range, correct_block_meta, set_scene_initial_meta, restore_revision_content]
        payload:
          type: object
          additionalProperties: true
      additionalProperties: false
    EditPreviewRequest:
      type: object
      required: [operation, candidate_revision_id, candidate_created_at]
      properties:
        operation:
          $ref: "#/components/schemas/OperationEnvelope"
        candidate_revision_id:
          type: string
        candidate_created_at:
          type: string
          format: date-time
      additionalProperties: false
    CommitRequest:
      allOf:
        - $ref: "#/components/schemas/EditPreviewRequest"
    UndoPreviewRequest:
      type: object
      required: [base_revision_id, restore_revision_id, expected_restore_hash, candidate_revision_id, candidate_created_at]
      properties:
        base_revision_id:
          type: string
        restore_revision_id:
          type: string
        expected_restore_hash:
          type: string
        candidate_revision_id:
          type: string
        candidate_created_at:
          type: string
          format: date-time
      additionalProperties: false
    PreviewResponse:
      type: object
      required: [base_revision_id, base_hash, normalized_operation, candidate_hash, diff, render_packet, violations, warnings, committable]
      properties:
        base_revision_id:
          type: string
        base_hash:
          type: string
        normalized_operation:
          $ref: "#/components/schemas/OperationEnvelope"
        candidate_hash:
          type: string
        diff:
          type: object
        render_packet:
          oneOf:
            - $ref: "#/components/schemas/RenderPacket"
            - type: "null"
        violations:
          type: array
          items:
            type: object
        warnings:
          type: array
          items:
            type: object
        committable:
          type: boolean
