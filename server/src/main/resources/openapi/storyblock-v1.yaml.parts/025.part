          type: boolean
        job_id:
          type: string
          pattern: '^job_[0-9a-f-]{36}$'
        status:
          const: queued
        status_uri:
          type: string
          format: uri-reference
      additionalProperties: false
    StyleMaskingLexicon:
      type: object
      required: [names, places]
      properties:
        names:
          type: array
          uniqueItems: true
          items:
            type: string
            minLength: 1
            maxLength: 128
        places:
          type: array
          uniqueItems: true
          items:
            type: string
            minLength: 1
            maxLength: 128
      additionalProperties: false
    RewriteProposalRequest:
      type: object
      required: [analysis_id, novel_id, revision_id, revision_hash, finding_ids]
      properties:
        analysis_id:
          type: string
          pattern: '^ana_[0-9a-f-]{36}$'
        novel_id:
          type: string
          pattern: '^nov_[0-9a-f-]{36}$'
        revision_id:
          type: string
          pattern: '^rev_[0-9a-f-]{36}$'
        revision_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        finding_ids:
          type: array
          minItems: 1
          maxItems: 64
          uniqueItems: true
          items:
            type: string
            pattern: '^sha256:[0-9a-f]{64}$'
        cooldown_seconds:
          type: integer
          minimum: 300
          maximum: 2592000
          default: 86400
      additionalProperties: false
    JobAccepted:
      type: object
      required: [job_id, status, status_uri]
      properties:
        job_id:
          type: string
        status:
          const: queued
        status_uri:
          type: string
          format: uri-reference
      additionalProperties: false
    Job:
      oneOf:
        - $ref: "#/components/schemas/ExportJob"
        - $ref: "#/components/schemas/StyleAnalysisJob"
    ExportJob:
      type: object
      required: [job_id, novel_id, revision_id, kind, status, attempt, result_artifact_id, result_uri, created_at, updated_at]
      properties:
        job_id:
          type: string
          pattern: '^job_[0-9a-f-]{36}$'
        novel_id:
          type: string
          pattern: '^nov_[0-9a-f-]{36}$'
        revision_id:
          type: string
          pattern: '^rev_[0-9a-f-]{36}$'
        kind:
          const: canonical-export
        status:
          const: succeeded
        attempt:
          const: 1
        result_artifact_id:
          type: string
          pattern: '^art_[0-9a-f-]{36}$'
        result_uri:
          type: string
          format: uri-reference
        created_at:
          type: string
          format: date-time
        updated_at:
          type: string
