          format: date-time
      additionalProperties: false
    StyleAnalysisJobFields:
      type: object
      required: [analysis_id, attempt, created_at, failure_code, job_id, kind, max_attempts, novel_id, result_artifact_id, result_hash, retention_until, revision_id, status, updated_at]
      properties:
        analysis_id:
          type: string
          pattern: '^ana_[0-9a-f-]{36}$'
        attempt:
          type: integer
          minimum: 0
          maximum: 20
        created_at:
          type: string
          format: date-time
        failure_code:
          type: [string, "null"]
          pattern: '^[a-z][a-z0-9._-]{1,63}$'
        job_id:
          type: string
          pattern: '^job_[0-9a-f-]{36}$'
        kind:
          const: style-analysis
        max_attempts:
          type: integer
          minimum: 1
          maximum: 20
        novel_id:
          type: string
          pattern: '^nov_[0-9a-f-]{36}$'
        result_artifact_id:
          type: [string, "null"]
          pattern: '^art_[0-9a-f-]{36}$'
        result_hash:
          type: [string, "null"]
          pattern: '^sha256:[0-9a-f]{64}$'
        retention_until:
          type: string
          format: date-time
        revision_id:
          type: string
          pattern: '^rev_[0-9a-f-]{36}$'
        status:
          type: string
          enum: [queued, running, succeeded, failed]
        updated_at:
          type: string
          format: date-time
    StyleAnalysisJob:
      allOf:
        - $ref: "#/components/schemas/StyleAnalysisJobFields"
      unevaluatedProperties: false
    StyleAnalysisView:
      allOf:
        - $ref: "#/components/schemas/StyleAnalysisJobFields"
        - type: object
          properties:
            result:
              $ref: "#/components/schemas/StyleAnalysisResult"
            trace_uri:
              type: string
              format: uri-reference
            windows_uri:
              type: string
              format: uri-reference
      unevaluatedProperties: false
    StyleAnalysisResult:
      type: object
      required: [analysis_id, completed_at, job_id, result_hash, summary, trace_artifact_id, trace_content_hash, trace_expires_at, trace_uncompressed_bytes]
      properties:
        analysis_id:
          type: string
          pattern: '^ana_[0-9a-f-]{36}$'
        completed_at:
          type: string
          format: date-time
        job_id:
          type: string
          pattern: '^job_[0-9a-f-]{36}$'
        result_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        summary:
          $ref: "#/components/schemas/StyleAnalysisSummary"
        trace_artifact_id:
          type: string
          pattern: '^art_[0-9a-f-]{36}$'
        trace_content_hash:
