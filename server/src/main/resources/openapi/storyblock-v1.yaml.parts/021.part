            $ref: "#/components/schemas/DetectorFinding"
      additionalProperties: false
    DetectorFinding:
      type: object
      required: [finding_id, code, severity, revision_id, revision_hash, rule_version, affected_block_ids, affected_scene_ids, context_block_ids, evidence]
      properties:
        finding_id:
          type: string
          pattern: '^fnd_[0-9a-f-]{36}$'
        code:
          type: string
          enum: [LOCATION_CHANGED_WITHOUT_TRANSITION, CHARACTER_APPEARED_WITHOUT_ENTER, CHARACTER_DISAPPEARED_WITHOUT_EXIT, WEATHER_CHANGED_WITHOUT_EVIDENCE, TIME_DISCONTINUITY, POV_CHANGED_WITHOUT_BOUNDARY, META_TEXT_MISMATCH, INTENTIONAL_SCENE_RESET]
        severity:
          type: string
          enum: [error, warning, info]
        revision_id:
          type: string
        revision_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        rule_version:
          type: string
        affected_block_ids:
          type: array
          uniqueItems: true
          items:
            type: string
        affected_scene_ids:
          type: array
          minItems: 1
          uniqueItems: true
          items:
            type: string
        context_block_ids:
          type: array
          maxItems: 3
          uniqueItems: true
          items:
            type: string
        evidence:
          type: object
          additionalProperties: true
      additionalProperties: false
    MonitorPacketRequest:
      type: object
      required: [revision_id, revision_hash, target_block_id, neighbor_count]
      properties:
        revision_id:
          type: string
          pattern: '^rev_[0-9a-f-]{36}$'
        revision_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        target_block_id:
          type: string
          pattern: '^blk_[0-9a-f-]{36}$'
        neighbor_count:
          type: integer
          minimum: 1
          maximum: 2
      additionalProperties: false
    MonitorPacket:
      type: object
      required: [novel_id, revision_id, revision_hash, monitor_version, rule_version, detector_rule_version, target_block_id, neighbor_count, render_packet, detector_findings, local_invariants, allowed_tools]
      properties:
        novel_id:
          type: string
          pattern: '^nov_[0-9a-f-]{36}$'
        revision_id:
          type: string
          pattern: '^rev_[0-9a-f-]{36}$'
        revision_hash:
          type: string
          pattern: '^sha256:[0-9a-f]{64}$'
        monitor_version:
          type: string
        rule_version:
          type: string
        detector_rule_version:
          type: string
        target_block_id:
          type: string
          pattern: '^blk_[0-9a-f-]{36}$'
        neighbor_count:
          type: integer
