  color: var(--muted);
}
.tab-button.active {
  border-bottom-color: var(--accent);
  color: var(--text);
}

.operator-bar {
  padding: 12px clamp(16px, 4vw, 48px);
  border-bottom: 1px solid var(--border);
  background: var(--accent-soft);
}
.operator-form {
  display: grid;
  grid-template-columns: minmax(220px, 1fr) minmax(360px, 1.4fr) auto;
  align-items: center;
  gap: 14px 20px;
  max-width: 1500px;
  margin: 0 auto;
}
.operator-copy { display: grid; gap: 3px; }
.operator-copy strong { font-size: 13px; }
.operator-copy span { color: var(--muted); font-size: 12px; line-height: 1.4; }
.operator-controls { display: grid; grid-template-columns: minmax(180px, 1fr) auto auto; gap: 8px; }
#operator-token { width: 100%; min-width: 0; }
#operator-connect { border-color: var(--accent); background: var(--accent); color: #fff; }
.operator-status {
  min-width: 190px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 700;
  text-align: right;
}
.operator-status[data-state="checking"] { color: var(--warning); }
.operator-status[data-state="active"] { color: var(--accent); }
.operator-status[data-state="error"] { color: #a33030; }

main { width: 100%; }
.view { padding: 0 clamp(16px, 3vw, 40px) 40px; }
.library-toolbar {
  min-height: 84px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  max-width: 1500px;
  margin: 0 auto;
}
.library-toolbar h2,
.console-heading h2 { font-size: 18px; }
.muted { margin-top: 4px; color: var(--muted); font-size: 13px; }
.search-controls { display: flex; gap: 8px; }
.search-controls input { width: min(360px, 52vw); min-height: 38px; padding: 7px 10px; }

.library-layout {
  display: grid;
  grid-template-columns: minmax(260px, 340px) minmax(0, 1fr);
  min-height: calc(100vh - 295px);
  max-width: 1500px;
  margin: 0 auto;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--surface);
  overflow: hidden;
}
.catalog-pane {
  display: flex;
  min-width: 0;
  flex-direction: column;
  border-right: 1px solid var(--border);
  background: var(--surface-subtle);
}
.novel-list {
  flex: 1;
  margin: 0;
  padding: 0;
  list-style: none;
  overflow-y: auto;
}
.novel-list li { border-bottom: 1px solid var(--border); }
.novel-item {
  width: 100%;
  min-height: 90px;
  padding: 14px 16px;
  border: 0;
  border-left: 4px solid transparent;
  border-radius: 0;
  background: transparent;
  text-align: left;
}
.novel-item:hover { background: var(--surface); }
.novel-item.selected {
  border-left-color: var(--accent);
  background: var(--surface);
}
.novel-item strong,
.novel-item span { display: block; }
.novel-item strong {
  overflow: hidden;
  color: var(--text);
  font-size: 14px;
  text-overflow: ellipsis;
  white-space: nowrap;
}
