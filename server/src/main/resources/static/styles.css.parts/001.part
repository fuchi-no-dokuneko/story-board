:root {
  color-scheme: light dark;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #f4f5f7;
  color: #1f252b;
  letter-spacing: 0;
  --surface: #ffffff;
  --surface-subtle: #f8f9fa;
  --border: #cdd2d8;
  --border-strong: #aeb6bf;
  --text: #1f252b;
  --muted: #626c76;
  --accent: #176b4c;
  --accent-soft: #e7f4ed;
  --warning: #8a4a10;
  --warning-soft: #fff3df;
  --header: #20252a;
}

* { box-sizing: border-box; }
[hidden] { display: none !important; }

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: #f4f5f7;
  color: var(--text);
}

button,
input,
select,
textarea { font: inherit; }

button,
input,
select,
textarea {
  border: 1px solid var(--border-strong);
  border-radius: 4px;
  background: var(--surface);
  color: var(--text);
}

button {
  min-height: 36px;
  padding: 7px 13px;
  cursor: pointer;
  font-weight: 650;
}

button:hover:not(:disabled) { border-color: var(--accent); }
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 3px solid color-mix(in srgb, var(--accent) 28%, transparent);
  outline-offset: 1px;
}
button:disabled { cursor: default; opacity: 0.48; }

h1,
h2,
h3,
p { margin: 0; }

.app-header {
  min-height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 12px clamp(16px, 4vw, 48px);
  background: var(--header);
  color: #f7f8fa;
  border-bottom: 3px solid #32a36d;
}

.brand,
.header-state,
.service-status,
.reader-heading,
.console-heading,
.response-heading {
  display: flex;
  align-items: center;
}

.brand { gap: 11px; }
.brand-mark {
  display: grid;
  width: 38px;
  height: 38px;
  place-items: center;
  border: 1px solid #6e7882;
  border-radius: 5px;
  background: #121619;
  font-size: 13px;
  font-weight: 800;
}
.brand h1 { font-size: 20px; line-height: 1.15; }
.brand p { margin-top: 3px; color: #bfc6ce; font-size: 12px; }
.header-state { gap: 16px; }
.readonly-badge,
.registration-state {
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
}
.readonly-badge {
  padding: 4px 9px;
  border: 1px solid #7f8993;
  color: #e9edf1;
}
.service-status { gap: 7px; color: #d2d7dc; font-size: 12px; }
#status-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #d39a35;
}
#status-dot.up { background: #48b87b; }
#status-dot.down { background: #df6666; }

.view-tabs {
  display: flex;
  gap: 24px;
  min-height: 48px;
  padding: 0 clamp(16px, 4vw, 48px);
  background: var(--surface);
  border-bottom: 1px solid var(--border);
}
.tab-button {
  min-height: 48px;
  padding: 0 2px;
  border: 0;
  border-bottom: 3px solid transparent;
  border-radius: 0;
  background: transparent;
