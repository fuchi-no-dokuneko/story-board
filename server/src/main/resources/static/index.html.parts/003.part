              <p>Lower distances mean closer features; compare each column separately.
                數值越小代表特徵越接近，請逐欄比較。TXT 的敘事 metadata 有限。
                <a href="/style-math.html" target="_blank" rel="noopener">Formulas / 計算公式</a></p>
              <div class="style-table-scroll">
                <table aria-label="Style scores / 風格分數">
                  <thead><tr><th>風格 / Style</th><th>表層 / Surface</th><th>語法 / Grammar</th>
                    <th>節奏 / Rhythm</th><th>敘事 / Narrative</th><th>詞彙 / Lexical</th></tr></thead>
                  <tbody id="style-score-rows"></tbody>
                </table>
              </div>
            </section>
            <section class="style-panel quality-panel" aria-labelledby="quality-title">
              <h3 id="quality-title">Quality indices / 品質指標</h3>
              <label for="quality-names">Proper names, comma separated / 專名，以逗號分隔</label>
              <input id="quality-names" type="text" placeholder="林小雨, 陳明">
              <button id="analyze-quality" type="button">Analyze quality / 分析品質</button>
              <button id="download-quality" type="button" disabled>Save report / 儲存報告</button>
              <p id="quality-status" role="status"></p>
              <label for="quality-window">Text range / 文本範圍</label>
              <select id="quality-window"><option value="all">Whole text / 全文</option></select>
              <div class="style-table-scroll"><table aria-label="Quality indices / 品質指標">
                <thead><tr><th>Index / 指標</th><th>Value / 數值</th><th>Samples / 樣本</th><th>Percentile / 分位數</th><th>State / 狀態</th></tr></thead>
                <tbody id="quality-score-rows"></tbody>
              </table></div>
              <p id="quality-statistics"></p>
              <div id="quality-evidence"></div>
            </section>
            <div class="character-strip">
              <h3>Main characters</h3>
              <ul id="character-list"></ul>
            </div>

            <div class="reader-body">
              <nav id="chapter-nav" class="chapter-nav" aria-label="Chapters"></nav>
              <div id="chapter-content" class="chapter-content"></div>
            </div>

            <details class="revision-details">
              <summary>Revision metadata</summary>
              <dl>
                <div><dt>Revision</dt><dd id="meta-revision"></dd></div>
                <div><dt>Updated</dt><dd id="meta-updated"></dd></div>
                <div><dt>Content hash</dt><dd id="meta-hash"></dd></div>
                <div><dt>Han text SHA-256</dt><dd id="meta-han-hash"></dd></div>
              </dl>
