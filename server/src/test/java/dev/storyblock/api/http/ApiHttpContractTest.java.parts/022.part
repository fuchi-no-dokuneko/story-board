        ), "secret");
        StyleProfileScope scope = new StyleProfileScope(
                new Ids.NovelId(novelId), StyleScopeKind.NOVEL, null
        );
        byte[] profileBody = CanonicalJson.bytes(Map.of(
                "name", "HTTP style baseline",
