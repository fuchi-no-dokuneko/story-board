                .andExpect(status().isPreconditionFailed())
                .andExpect(jsonPath("$.code").value("REVISION_CONFLICT"))
                .andExpect(jsonPath("$.current_revision_id").value(revisionId))
                .andExpect(jsonPath("$.current_etag").value(revision.contentHash()));
    }

