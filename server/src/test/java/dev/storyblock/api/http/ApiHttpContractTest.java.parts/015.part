                        .with(userWithScope("novel:analyze"))
                        .header(MutationPreconditionFilter.IDEMPOTENCY_KEY, "packet-denied")
                        .header(HttpHeaders.IF_MATCH, quotedEtag(revision.contentHash()))
                        .contentType(MediaType.APPLICATION_JSON)
                        .content(packetBody))
