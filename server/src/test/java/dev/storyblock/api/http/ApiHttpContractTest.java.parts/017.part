                        .with(userWithScope("novel:read")))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.monitor_run_id").value(runId))
                .andExpect(jsonPath("$.state").value("current"))
                .andExpect(jsonPath("$.rebase_allowed").value(false));
    }

