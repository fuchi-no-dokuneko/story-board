        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-detector</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-style</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-storage-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-storage-sqlite</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-monitor-adapter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-rewrite</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.storyblock</groupId>
        <artifactId>storyblock-rewrite-policy</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.3</version>
          <configuration>
            <useModulePath>false</useModulePath>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.5.3</version>
          <configuration>
            <useModulePath>false</useModulePath>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
