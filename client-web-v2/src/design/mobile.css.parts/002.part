@media (min-width:761px) and (max-height:930px){.phone{transform:scale(calc((100vh - 56px) / 866));transform-origin:center}}
@media (max-width:760px){
  body{background:var(--bg)}
  .stage{display:block;padding:0}.jump{display:none}
  .phone{width:100%;height:100vh;height:100dvh;border-radius:0;box-shadow:none}
  .notch{display:none}
  :root{--dn-bottom:calc(92px + env(safe-area-inset-bottom))}
}

/* app shell */
.screen{position:absolute;inset:0;display:flex;flex-direction:column;background:var(--bg)}
.scroll{flex:1;overflow:auto;overscroll-behavior:contain;padding:54px 18px 110px}
@media (max-width:760px){.scroll{padding-top:calc(14px + env(safe-area-inset-top))}}
.bigtitle{display:flex;align-items:center;justify-content:space-between;margin:8px 2px 14px}
.bigtitle h1{margin:0;font:800 32px/1.1 var(--sans);letter-spacing:-.02em}
.chip{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 11px;border-radius:999px;background:var(--ok-soft);color:var(--ok);font-size:12.5px;font-weight:700;border:0}
.chip i{width:7px;height:7px;border-radius:50%;background:currentColor}
.search{display:flex;align-items:center;gap:8px;height:44px;padding:0 14px;border-radius:14px;background:color-mix(in srgb,var(--ink) 6%,transparent);color:var(--muted)}
.search input{flex:1;min-width:0;height:100%;border:0;background:none;outline:0;font-size:16px}
.card{border-radius:22px;background:var(--card);box-shadow:0 1px 2px rgba(20,20,40,.04),0 10px 30px -12px rgba(20,20,40,.14)}
.cont{display:grid;grid-template-columns:auto 1fr;gap:14px;align-items:center;margin:16px 0 22px;padding:14px;width:100%;border:0;text-align:left}
.cover{position:relative;display:flex;justify-content:center;padding-top:10px;width:62px;height:86px;border-radius:4px 10px 10px 4px;background:linear-gradient(160deg,hsl(var(--h) 45% 44%),hsl(calc(var(--h) + 25) 45% 25%));color:#fff;box-shadow:inset 4px 0 0 rgba(0,0,0,.2),0 8px 16px -8px rgba(0,0,0,.5);flex:none}
.cover span{writing-mode:vertical-rl;font:700 13px/1.2 var(--serif);letter-spacing:.1em}
.cover.latin span{writing-mode:horizontal-tb;font-size:10.5px;text-align:center;padding:0 6px;letter-spacing:0}
.cover.lg{width:132px;height:184px;border-radius:6px 16px 16px 6px;padding-top:22px}
.cover.lg span{font-size:24px}
.cover.sm{width:48px;height:66px;padding:0;align-items:center}.cover.sm .one{writing-mode:horizontal-tb;font:700 21px var(--serif);letter-spacing:0}
.kicker{margin:0;color:var(--accent);font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
.cont h2{margin:2px 0 2px;font:700 20px/1.25 var(--serif)}
.cont p{margin:0;color:var(--muted);font-size:13px}
