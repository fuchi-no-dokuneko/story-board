.stats{display:grid;grid-template-columns:repeat(4,1fr);margin:6px 0 16px;padding:14px 6px}
.stats div{text-align:center;border-right:1px solid var(--line)}.stats div:last-child{border-right:0}
.stats b{display:block;font-size:19px}.stats small{color:var(--muted);font-size:11.5px}
.btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;height:52px;border:0;border-radius:16px;background:var(--accent);color:var(--on-accent);font-weight:700;font-size:16.5px}
.btn.sec{background:var(--card);color:var(--ink);box-shadow:inset 0 0 0 1px var(--line)}
.btn:disabled{opacity:.5}
.btn.sm{height:40px;border-radius:12px;font-size:14.5px;width:auto;padding:0 16px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.chs .row b{font-size:15.5px}

/* reader */
.reader{background:var(--bg)}
.reader .scroll{padding:100px 24px 150px}
@media (max-width:760px){.reader .scroll{padding-top:calc(70px + env(safe-area-inset-top))}}
.rtop,.rbot{position:absolute;z-index:20;left:0;right:0;transition:transform .25s ease,opacity .25s ease;background:color-mix(in srgb,var(--bg) 86%,transparent);backdrop-filter:blur(14px)}
.rtop{top:0;display:flex;align-items:center;gap:6px;height:96px;padding:44px 8px 0;border-bottom:1px solid var(--line)}
@media (max-width:760px){.rtop{height:calc(56px + env(safe-area-inset-top));padding-top:env(safe-area-inset-top)}}
.rtop .t{flex:1;min-width:0;text-align:center}.rtop .t b{display:block;font:700 14px var(--serif);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rtop .t small{color:var(--muted);font-size:12px}
.rbot{bottom:0;padding:12px 16px calc(22px + env(safe-area-inset-bottom));border-top:1px solid var(--line)}
.reader.immersive .rtop{transform:translateY(-100%);opacity:0}.reader.immersive .rbot{transform:translateY(100%);opacity:0}
.slider{display:flex;align-items:center;gap:10px;color:var(--muted);font-size:12.5px}
.slider input{flex:1;accent-color:var(--accent)}
.tools{display:flex;justify-content:space-around;margin-top:8px}
.tools button{display:grid;justify-items:center;gap:2px;min-width:64px;padding:6px;border:0;background:none;color:var(--ink);font-size:11.5px;font-weight:600}
.tools svg{width:22px;height:22px}
.rtext{--fs:19px;font-family:var(--serif)}
.rtext h2{margin:18px 0 4px;text-align:center;font:700 22px var(--serif);letter-spacing:.05em}
.rtext .meta{margin:0 0 22px;text-align:center;color:var(--faint);font:12.5px var(--sans)}
.story-block{margin:0 0 1em;font-size:var(--fs);line-height:2;text-indent:2em;text-align:justify;overflow-wrap:anywhere}
.story-block mark{background:var(--mark);color:inherit;border-radius:3px}
