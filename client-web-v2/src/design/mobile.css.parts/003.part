.bar{height:6px;margin-top:10px;border-radius:9px;background:var(--line);overflow:hidden}.bar i{display:block;height:100%;background:var(--accent);border-radius:9px}
.segs{display:flex;gap:6px;margin:0 -18px 12px;padding:0 18px;overflow-x:auto;scrollbar-width:none}
.segs button{flex:none;height:34px;padding:0 14px;border:0;border-radius:999px;background:color-mix(in srgb,var(--ink) 6%,transparent);font-weight:650;font-size:14px;color:var(--muted)}
.segs button[aria-pressed=true]{background:var(--navy);color:var(--bg)}
.sech{display:flex;justify-content:space-between;align-items:baseline;margin:22px 4px 10px}
.sech h3{margin:0;font-size:19px}.sech span{color:var(--muted);font-size:13px}
.list{margin:0;padding:6px 14px;list-style:none}
.row{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;width:100%;padding:12px 0;border:0;border-bottom:1px solid var(--line);background:none;text-align:left}
.list li:last-child .row{border-bottom:0}
.row b{display:block;font:700 16.5px/1.3 var(--serif)}
.row small{display:block;margin-top:2px;color:var(--muted);font-size:13px}
.row .chev{color:var(--faint);font-size:20px}
.tagw{display:inline-block;margin-left:6px;padding:1px 7px;border-radius:999px;background:var(--warn-soft);color:var(--warn);font:700 11px var(--sans);vertical-align:1px}

/* nav bar (pushed screens) */
.nav{position:absolute;z-index:20;top:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;gap:8px;height:96px;padding:44px 10px 0;background:color-mix(in srgb,var(--bg) 82%,transparent);backdrop-filter:blur(14px);border-bottom:1px solid color-mix(in srgb,var(--line) 70%,transparent)}
@media (max-width:760px){.nav{height:calc(56px + env(safe-area-inset-top));padding-top:env(safe-area-inset-top)}}
.nav b{flex:1;text-align:center;font-size:16px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.nb{display:inline-flex;align-items:center;gap:2px;min-width:44px;height:44px;padding:0 8px;border:0;border-radius:12px;background:none;color:var(--accent);font-weight:600;font-size:16px}
.nb.icon{justify-content:center;color:var(--ink)}
.pushed .scroll{padding-top:112px}
@media (max-width:760px){.pushed .scroll{padding-top:calc(72px + env(safe-area-inset-top))}}

/* book page */
.bookhero{display:grid;justify-items:center;gap:10px;text-align:center;margin-bottom:18px}
.bookhero h1{margin:6px 0 0;font:800 28px/1.2 var(--serif)}
.bookhero p{margin:0;color:var(--muted);font-size:14px}
.cast{display:flex;gap:6px;justify-content:center;flex-wrap:wrap}
.cast span{padding:4px 11px;border-radius:999px;background:var(--card);border:1px solid var(--line);font:600 13.5px var(--serif)}
