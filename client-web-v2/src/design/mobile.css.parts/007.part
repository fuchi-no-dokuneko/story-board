.qr button{height:36px;padding:0 12px;border:1px solid var(--line);border-radius:10px;background:var(--card);font:12.5px var(--mono)}
.cres{min-height:260px;margin:0;padding:14px;border-radius:16px;background:#101522;color:#dde3f2;font:12.5px/1.55 var(--mono);white-space:pre-wrap;overflow:auto}

/* tab bar */
.tabbar{position:absolute;z-index:30;left:0;right:0;bottom:0;display:grid;grid-template-columns:repeat(4,1fr);padding:8px 6px calc(26px + env(safe-area-inset-bottom));background:color-mix(in srgb,var(--bg) 82%,transparent);backdrop-filter:blur(16px);border-top:1px solid color-mix(in srgb,var(--line) 80%,transparent)}
@media (max-width:760px){.tabbar{padding-bottom:calc(10px + env(safe-area-inset-bottom))}}
.tabbar button{display:grid;justify-items:center;gap:3px;padding:4px 0;border:0;background:none;color:var(--faint);font-size:11px;font-weight:700}
.tabbar button[aria-current=true]{color:var(--accent)}
.tabbar svg{width:25px;height:25px}

/* sheets */
.scrim{position:absolute;inset:0;z-index:80;background:rgba(10,12,20,.35);animation:fade .2s}
.sheet{position:absolute;z-index:81;left:0;right:0;bottom:0;max-height:82%;display:flex;flex-direction:column;border-radius:26px 26px 0 0;background:var(--card);box-shadow:0 -20px 50px rgba(0,0,0,.25);animation:up .25s ease}
.sheet .grab{width:40px;height:5px;margin:8px auto 4px;border-radius:9px;background:var(--line)}
.sheet .sh{display:flex;justify-content:space-between;align-items:center;padding:6px 18px 10px}
.sheet .sh b{font-size:18px}
.sheet .sb{padding:0 18px calc(26px + env(safe-area-inset-bottom));overflow:auto}
@keyframes up{from{transform:translateY(100%)}}@keyframes fade{from{opacity:0}}
.act{display:grid;grid-template-columns:auto 1fr;gap:14px;align-items:center;width:100%;padding:12px 4px;border:0;border-bottom:1px solid var(--line);background:none;text-align:left}
.act:last-child{border-bottom:0}.act:disabled{opacity:.45}
.act .i{display:grid;place-items:center;width:44px;height:44px;border-radius:13px;background:var(--accent-soft);color:var(--accent);font:800 11px var(--mono)}
.act b{display:block;font-size:16px}.act small{color:var(--muted);font-size:13px}
.aa .set span{font-size:15px}
.evs{display:grid;gap:10px;margin-top:12px}
.ev{padding:12px 14px;border-radius:14px;background:var(--bg)}
.ev p{margin:0 0 8px;font:15.5px/1.75 var(--serif)}
.ev small{display:block;color:var(--faint);font-size:12px;margin-bottom:8px}
