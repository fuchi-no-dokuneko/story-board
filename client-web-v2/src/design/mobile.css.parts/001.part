
:root{
  --sans:system-ui,-apple-system,"Segoe UI","PingFang TC","Noto Sans CJK TC","Microsoft JhengHei",sans-serif;
  --serif:"Noto Serif CJK TC","Noto Serif TC","Songti TC","PMingLiU","Noto Serif CJK SC",Georgia,serif;
  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  --bg:#f6f3ee; --card:#ffffff; --ink:#172033; --muted:#687085; --faint:#9aa1b2; --line:#ebe5db; --accent:#e25a45; --accent-soft:#fde7e2; --navy:#1d2a47;
  --ok:#1f8a5b; --ok-soft:#ddf3e8; --warn:#9a5d00; --warn-soft:#fff0d2; --mark:#ffe17d; --desk:#e9e4dc;
  --dn-left:auto; --dn-right:18px; --on-accent:#fff;
  color-scheme:light;
}
:root[data-theme=dark]{--bg:#0f1320;--card:#182033;--ink:#e9ecf4;--muted:#a3abbe;--faint:#727b92;--line:#263049;--accent:#ff8a73;--accent-soft:#3b2521;--navy:#aab8e0;--ok:#62d19c;--ok-soft:#133428;--warn:#f1b85a;--warn-soft:#352a12;--mark:#6a5716;--desk:#070a12;--on-accent:#2a0f09;color-scheme:dark}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#0f1320;--card:#182033;--ink:#e9ecf4;--muted:#a3abbe;--faint:#727b92;--line:#263049;--accent:#ff8a73;--accent-soft:#3b2521;--navy:#aab8e0;--ok:#62d19c;--ok-soft:#133428;--warn:#f1b85a;--warn-soft:#352a12;--mark:#6a5716;--desk:#070a12;--on-accent:#2a0f09;color-scheme:dark}}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}[hidden]{display:none!important}
html,body{margin:0;height:100%}
body{background:var(--desk);color:var(--ink);font:16px/1.45 var(--sans);-webkit-font-smoothing:antialiased}
button,input{font:inherit;color:inherit}button{cursor:pointer}
:focus-visible{outline:3px solid color-mix(in srgb,var(--accent) 50%,transparent);outline-offset:2px}

/* desktop stage */
.stage{display:flex;justify-content:center;align-items:center;gap:48px;min-height:100%;padding:28px}
.jump{width:260px;font-size:14px}
.jump h1{margin:0 0 4px;font:700 22px var(--sans)}
.jump p{margin:0 0 16px;color:var(--muted);font-size:13.5px}
.jump h2{margin:18px 0 8px;color:var(--faint);font-size:11.5px;letter-spacing:.07em;text-transform:uppercase}
.jump button{display:flex;align-items:center;justify-content:space-between;width:100%;margin-bottom:6px;padding:10px 12px;border:1px solid var(--line);border-radius:12px;background:var(--card);text-align:left;font-weight:600;font-size:13.5px}
.jump button:hover{border-color:var(--accent)}
.phone{position:relative;width:390px;height:844px;border-radius:52px;background:var(--bg);overflow:hidden;box-shadow:0 0 0 11px #11141b,0 0 0 13px #3a3f4a,0 40px 80px -20px rgba(0,0,0,.45)}
.notch{position:absolute;z-index:200;top:10px;left:50%;width:120px;height:34px;margin-left:-60px;border-radius:20px;background:#0b0d12}
