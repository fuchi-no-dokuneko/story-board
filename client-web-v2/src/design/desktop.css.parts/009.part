.chart:focus-visible{outline:3px solid color-mix(in srgb,var(--accent) 45%,transparent);outline-offset:2px}
.spark{position:absolute;inset:6px 0 4px;width:100%;height:calc(100% - 10px)}
.spark-area{fill:color-mix(in srgb,var(--accent) 16%,transparent)}
.spark-line{fill:none;stroke:var(--accent);stroke-width:1.4}
.spark-cursor{stroke:var(--ink);stroke-width:2}
.spark-peak{stroke:var(--warn);stroke-width:3}
.range{display:flex;justify-content:space-between;gap:8px;margin-top:6px;color:var(--muted);font:12px var(--mono)}
.stepper{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:8px;margin-top:10px}
.stepper .where{min-width:0;text-align:center;font-size:13px;line-height:1.35}
.stepper .where b{display:block;font-size:13.5px}
.stepper .where span{color:var(--muted);font-size:12px}
.jumps{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.scope{display:flex;align-items:center;gap:8px;margin:14px 0 4px;padding:8px 10px;border-radius:10px;background:var(--accent-soft);color:var(--accent);font-size:13px;font-weight:600}
.scope span{flex:1;min-width:0}
.scope button{border:0;background:none;color:inherit;font-weight:700;padding:2px 6px;border-radius:6px}
.wchips{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.wchips button{height:32px;padding:0 11px;border:1px solid var(--line-strong);border-radius:8px;background:var(--card);font-size:12.5px;font-weight:650}
.wchips button[aria-pressed=true]{background:var(--ink);border-color:var(--ink);color:var(--paper)}
.metric .whole{color:var(--faint);font:12px var(--mono)}
.win-band{background:color-mix(in srgb,var(--accent) 9%,transparent);box-shadow:-10px 0 0 color-mix(in srgb,var(--accent) 9%,transparent),10px 0 0 color-mix(in srgb,var(--accent) 9%,transparent)}
.win-band.first{border-top:2px solid var(--accent)}
.toast{position:fixed;z-index:95;left:50%;bottom:28px;transform:translateX(-50%);display:flex;align-items:center;gap:10px;padding:11px 16px;border-radius:12px;background:var(--ink);color:var(--paper);font:600 13.5px var(--sans);box-shadow:0 12px 30px rgba(0,0,0,.25)}
.spin{width:14px;height:14px;border:2px solid currentColor;border-right-color:transparent;border-radius:50%;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* console modal */
.modal{position:fixed;inset:0;z-index:90;display:grid;place-items:center;padding:16px;background:rgba(20,15,5,.4)}
.modal .box{display:flex;flex-direction:column;width:min(860px,100%);max-height:88vh;border-radius:16px;background:var(--card);box-shadow:0 30px 80px rgba(0,0,0,.35);overflow:hidden}
