.search input{width:100%;height:40px;padding:0 40px 0 38px;border:1px solid var(--line-strong);border-radius:999px;background:var(--card)}
.search svg{position:absolute;left:13px;top:11px;color:var(--muted)}
.search kbd{position:absolute;right:10px;top:9px;padding:1px 7px;border:1px solid var(--line-strong);border-radius:6px;color:var(--muted);font:12px var(--mono)}
.right{display:flex;align-items:center;gap:8px;margin-left:auto}
.search + .right{margin-left:0}
.seg{display:inline-flex;padding:3px;border:1px solid var(--line);border-radius:999px;background:var(--card)}
.seg button{min-width:34px;height:30px;padding:0 9px;border:0;border-radius:999px;background:none;color:var(--muted);font-weight:650;font-size:13px}
.seg button[aria-pressed=true]{background:var(--ink);color:var(--paper)}
.pill{display:inline-flex;align-items:center;gap:8px;height:38px;padding:0 13px;border:1px solid var(--line);border-radius:999px;background:var(--card);font-size:13px;font-weight:600;white-space:nowrap}
.dot{width:8px;height:8px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 3px var(--ok-soft)}
.pill .ro{padding-left:8px;border-left:1px solid var(--line);color:var(--muted);font-weight:500}

/* ---------- library ---------- */
.wrap{max-width:1240px;margin:0 auto;padding:28px clamp(14px,3vw,36px) 80px}
.hero{display:grid;grid-template-columns:auto 1fr auto;gap:22px;align-items:center;padding:20px;border:1px solid var(--line);border-radius:18px;background:var(--card);box-shadow:var(--shadow)}
.hero .cover{width:84px;height:118px}.hero .cover .t{font-size:15px}
.eyebrow{margin:0 0 4px;color:var(--accent);font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.hero h2{margin:0;font:700 26px/1.2 var(--serif)}
.hero p.sub{margin:6px 0 10px;color:var(--muted);font-size:13px}
.prog{height:6px;border-radius:9px;background:var(--line);overflow:hidden;max-width:360px}
.prog i{display:block;height:100%;background:var(--accent);border-radius:9px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:0 16px;border:1px solid var(--line-strong);border-radius:10px;background:var(--card);font-weight:650;font-size:14px;white-space:nowrap}
.btn:hover:not(:disabled){border-color:var(--ink)}
.btn.primary{background:var(--ink);border-color:var(--ink);color:var(--paper)}
.btn.accent{background:var(--accent);border-color:var(--accent);color:#fff}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn.ghost{border-color:transparent;background:none}
.btn.sm{min-height:32px;padding:0 11px;font-size:13px;border-radius:8px}
