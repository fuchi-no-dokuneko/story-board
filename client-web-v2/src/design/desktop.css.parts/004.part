.pager{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:40px;color:var(--muted);font-size:13px}
.empty{padding:60px 0;text-align:center;color:var(--muted)}

/* ---------- reader ---------- */
.rbar{position:sticky;top:0;z-index:60;display:flex;align-items:center;gap:8px;height:58px;padding:0 clamp(8px,2vw,24px);background:color-mix(in srgb,var(--rbg) 92%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.rbar .ttl{flex:1;min-width:0;text-align:center}
.rbar .ttl b{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font:700 14px/1.3 var(--serif)}
.rbar .ttl span{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--muted);font-size:12px}
.ib{display:inline-flex;align-items:center;gap:7px;height:38px;padding:0 11px;border:1px solid transparent;border-radius:10px;background:none;font-size:13.5px;font-weight:600}
.ib:hover{background:color-mix(in srgb,var(--ink) 7%,transparent)}
.ib[aria-expanded=true]{background:var(--ink);color:var(--rbg)}
.ib svg{flex:none}
.progress{position:absolute;left:0;right:0;bottom:-1px;height:2px}
.progress i{display:block;height:100%;width:0;background:var(--accent)}
#reader{--rbg:var(--paper);--rsize:18px;--rlh:2;--rw:36em;--rfont:var(--serif);background:var(--rbg);min-height:100vh}
#reader[data-rtheme=white]{--rbg:#ffffff;--paper:#ffffff}
#reader[data-rtheme=night]{--rbg:#101113;--paper:#101113;--card:#1a1b1e;--ink:#d9d6cf;--muted:#8f8b82;--line:#2a2b2f;--line-strong:#3b3c41;--mark:#5d4f12}
.rlayout{display:grid;grid-template-columns:minmax(0,1fr);position:relative}
.toc{position:fixed;z-index:70;top:0;bottom:0;left:0;width:min(330px,88vw);padding:18px 16px 40px;overflow:auto;background:var(--card);border-right:1px solid var(--line);box-shadow:var(--shadow);transform:translateX(-105%);transition:transform .22s ease}
.toc.open{transform:none}
@media (min-width:1280px){.rlayout{grid-template-columns:280px minmax(0,1fr) 280px}.toc{position:sticky;top:58px;height:calc(100vh - 58px);transform:none;box-shadow:none;background:transparent;border-right:0;width:auto}.toc .close{display:none}#tocBtn{display:none}}
.toc h4{margin:4px 6px 10px;color:var(--muted);font-size:12px;letter-spacing:.06em;text-transform:uppercase}
.toc ol{margin:0;padding:0;list-style:none}
.chapter-link{display:block;width:100%;padding:9px 10px;border:0;border-left:3px solid var(--line);background:none;text-align:left;font:600 14px/1.4 var(--serif);color:var(--muted)}
.chapter-link[aria-current=true]{border-left-color:var(--accent);color:var(--ink)}
.toc .scn{margin:2px 0 8px 13px;color:var(--faint);font-size:12px;line-height:1.5}
