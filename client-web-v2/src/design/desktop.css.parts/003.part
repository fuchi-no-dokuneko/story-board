.libhead{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:14px;margin:38px 0 16px}
.libhead h2{margin:0;font:700 22px/1.2 var(--sans)}
.libhead p{margin:4px 0 0;color:var(--muted);font-size:13px}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{height:32px;padding:0 12px;border:1px solid var(--line-strong);border-radius:999px;background:var(--card);font-size:13px;font-weight:600;color:var(--muted)}
.chip[aria-pressed=true]{background:var(--ink);border-color:var(--ink);color:var(--paper)}
.sort{height:32px;padding:0 10px;border:1px solid var(--line-strong);border-radius:8px;background:var(--card);font-size:13px}
.shelf{display:grid;grid-template-columns:repeat(auto-fill,minmax(168px,1fr));gap:30px 22px;margin:0;padding:0;list-style:none}
.book{display:block;width:100%;padding:0;border:0;background:none;text-align:left}
.cover{position:relative;display:flex;justify-content:center;align-items:flex-start;aspect-ratio:5/7;width:100%;padding:14% 10%;border-radius:4px 10px 10px 4px;color:#fff;overflow:hidden;
  background:linear-gradient(160deg,hsl(var(--h) 38% 38%),hsl(calc(var(--h) + 25) 42% 22%));
  box-shadow:inset 6px 0 0 rgba(0,0,0,.18),inset 7px 0 0 rgba(255,255,255,.12),0 2px 4px rgba(0,0,0,.12),0 14px 30px -12px rgba(0,0,0,.45);transition:transform .2s ease,box-shadow .2s ease}
.cover::before{content:"";position:absolute;inset:8% 9% 8% 12%;border:1px solid rgba(255,255,255,.28);border-radius:2px}
.cover .t{position:relative;writing-mode:vertical-rl;font:700 clamp(18px,2.2vw,24px)/1.25 var(--serif);letter-spacing:.12em;text-shadow:0 1px 1px rgba(0,0,0,.2)}
.cover.latin .t{writing-mode:horizontal-tb;letter-spacing:0;text-align:center;font-size:clamp(16px,1.8vw,20px);margin-top:18%}
.cover .stamp{position:absolute;left:14%;bottom:10%;display:grid;place-items:center;min-width:22px;height:22px;padding:0 4px;border-radius:3px;background:rgba(255,255,255,.9);color:hsl(var(--h) 45% 25%);font:700 10px/1 var(--sans)}
.cover .img{position:absolute;right:10%;bottom:10%;font:600 10px/1 var(--sans);opacity:.85}
.book:hover .cover,.book:focus-visible .cover{transform:translateY(-4px) rotate(-.4deg)}
.book h3{margin:12px 0 2px;font:700 15px/1.35 var(--serif);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.book .meta{color:var(--muted);font-size:12.5px}
.badge{display:inline-flex;align-items:center;gap:5px;padding:2px 8px;border-radius:999px;font-size:11.5px;font-weight:700}
.badge.ok{background:var(--ok-soft);color:var(--ok)}.badge.warn{background:var(--warn-soft);color:var(--warn)}.badge.mute{background:var(--line);color:var(--muted)}
