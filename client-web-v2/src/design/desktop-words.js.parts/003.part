  styleLead:{en:'How close is this revision to each reference style? Lower distance = closer. Each channel has its own scale, so compare down a channel, never across.',zh:'此版本與各參考風格有多接近？距離越小越接近。各特徵的尺度不同，只能同欄比較，不能跨欄相加。',zhs:'此版本与各参考风格有多接近？距离越小越接近。各特征的尺度不同，只能同栏比较，不能跨栏相加。'},
  formulas:{en:'How is this calculated?',zh:'計算方式',zhs:'计算方式'},
  refStyles:{en:'Reference styles',zh:'參考風格',zhs:'参考风格'}, change:{en:'change',zh:'變更',zhs:'变更'},
  compare:{en:'Compare',zh:'比較',zhs:'比较'}, stylesWord:{en:'styles',zh:'種風格',zhs:'种风格'},
  refresh:{en:'Refresh list',zh:'更新清單',zhs:'更新清单'}, calculating:{en:'Calculating…',zh:'計算中…',zhs:'计算中…'},
  calcAt:{en:'Calculated just now for',zh:'剛剛計算，版本',zhs:'刚刚计算，版本'}, notStored:{en:'not stored',zh:'結果不保存',zhs:'结果不保存'},
  closestPer:{en:'Closest style per channel',zh:'各特徵最接近的風格',zhs:'各特征最接近的风格'},
  table:{en:'Show raw table',zh:'顯示原始數值表',zhs:'显示原始数值表'}, bars:{en:'Show bars',zh:'顯示長條圖',zhs:'显示条形图'},
  files:{en:'files',zh:'個檔案',zhs:'个文件'}, graphemes:{en:'graphemes',zh:'字素',zhs:'字素'},
  partial:{en:'TXT references carry no narrative metadata — this channel is partial.',zh:'TXT 參考語料沒有敘事 metadata，此欄僅部分反映。',zhs:'TXT 参考语料没有叙事 metadata，此栏仅部分反映。'},
  names:{en:'Proper names',zh:'專有名詞',zhs:'专有名词'}, namesHint:{en:'Names are masked so they don’t count as repeated phrases. Pre-filled from the main characters.',zh:'專名會被遮罩，不計入重複片語。已預填主要角色。',zhs:'专名会被遮罩，不计入重复片语。已预填主要角色。'},
