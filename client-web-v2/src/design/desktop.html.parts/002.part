    <button class="ib" type="button" id="tocBtn" aria-expanded="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h10M4 18h13"/></svg><span class="lbl" data-i18n="contents"></span></button>
    <div class="ttl"><b id="rbar-title"></b><span id="rbar-chapter"></span></div>
    <button class="ib" type="button" id="aaBtn" aria-expanded="false" data-i18n-aria="display"><span data-css="font:700 15px var(--serif)">Aa</span></button>
    <button class="ib" type="button" id="exportBtn" aria-expanded="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14"/></svg><span class="lbl" data-i18n="export"></span></button>
    <button class="ib" type="button" id="insightsBtn" aria-expanded="false"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20V10m6 10V4m6 16v-7m4 7H2"/></svg><span class="lbl" data-i18n="insights"></span></button>
    <div class="progress"><i id="progress"></i></div>
  </div>
  <div class="rlayout">
    <aside class="toc" id="toc" aria-label="Contents">
      <div data-css="display:flex;justify-content:space-between;align-items:center"><h4 data-i18n="contents"></h4><button class="ib close" type="button" id="tocClose" aria-label="Close">✕</button></div>
      <ol id="chapter-nav"></ol>
      <div class="bookinfo" id="bookinfo"></div>
    </aside>
    <article class="page reader-pane" id="reader-content" aria-live="polite"></article>
    <div aria-hidden="true"></div>
  </div>
</div>

<!-- Insights drawer -->
<aside class="drawer" id="drawer" aria-label="Insights" role="dialog">
  <div class="dhead"><h3 data-i18n="insights"></h3><button class="ib" type="button" id="drawerClose" aria-label="Close">✕</button></div>
  <div class="tabs" role="tablist">
    <button class="tab" role="tab" data-tab="style" aria-selected="true" data-i18n="styleTab"></button>
    <button class="tab" role="tab" data-tab="quality" aria-selected="false" data-i18n="qualityTab"></button>
    <button class="tab" role="tab" data-tab="about" aria-selected="false" data-i18n="aboutTab"></button>
  </div>
  <div class="dbody" id="dbody"></div>
</aside>

<div id="layer"></div>


