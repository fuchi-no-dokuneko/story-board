            ${c.partial ? `<p class="field-hint">ⓘ ${t('partial')}</p>` : ''}</section>`;
        }).join('');
    results = `<div class="note info">✓ ${t('resultFor')} <b class="mono">${SB.comparison.revision_id}</b> · ${t('cachedNote')}</div>
      <p class="eyebrow" data-css="margin-top:18px">${t('closestPer')}</p><div class="closest">${closest}</div>
      <div data-css="display:flex;justify-content:flex-end;margin:-6px 0 10px"><button class="btn sm ghost" type="button" id="rawToggle">${S.raw ? t('bars') : t('table')}</button></div>${body}`;
  }
  return `<p class="lead">${t('styleLead')} <a href="/style-math.html" target="_blank" rel="noopener">${t('formulas')} ↗</a></p>
    ${S.compared
      ? `<details class="picked"><summary>${t('refStyles')} <span>${n} / ${SB.styles.length} · ${t('change')} ▾</span></summary><div id="style-choices">${opts}</div></details>`
      : `<div id="style-choices">${opts}</div>`}
    <div class="actions"><button class="btn accent" type="button" id="compare-styles" ${n ? '' : 'disabled'}>${t('compare')} ${n} ${t('stylesWord')}</button><button class="btn sm ghost" type="button" id="reload-styles">↻ ${t('refresh')}</button></div>
    <div id="style-results">${results}</div>`;
}
function dQualityTab() {
  const id=S.book,Q=SB.quality;
