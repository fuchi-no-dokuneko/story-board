    if (!st && n > 12) {
      across=`<div class="across"><header><b>${t('acrossBook')}</b></header><p>${t('noValues')}</p></div>`;
    } else if (n <= 12) {
      /* few windows: plain chips, no chart (F1 rule: chart only above 12 windows) */
      across = `<div class="across" data-testid="window-chips"><header><b>${t('acrossBook')} · ${FX.count(n, 'window')}</b></header>
        <div class="wchips" role="group" aria-label="${t('range')}"><button type="button" data-win="all" aria-pressed="${!w}">${t('whole')}</button>
        ${Q.windows.map((x) => `<button type="button" data-win="${x.i}" aria-pressed="${w?.i === x.i}" title="${FX.where(x)}">W${x.i + 1} · ${FX.where(x)}</button>`).join('')}</div></div>`;
    } else {
      const cur = w ? w.i : null;
