  let results = '';
  if (S.analyzed) {
    const n = Q.windows.length, w = S.win === 'all' ? null : Q.windows[+S.win];
    const plottable = Q.metrics.filter((m) => FX.series(Q, m.metric).some((v) => v != null));
    if (!plottable.some((m) => m.metric === S.winMetric)) S.winMetric = plottable[0]?.metric;
    const series = FX.series(Q, S.winMetric), st = FX.stats(series);
