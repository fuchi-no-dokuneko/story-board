  $('#novel-list').innerHTML = list.slice(S.page*12,S.page*12+12).map((n) => `
    <li><button class="book novel-item" type="button" data-open="${n.novel_id}" data-novel-id="${n.novel_id}">
      ${dCover(n)}
      <h3>${H.esc(n.title)}</h3>
      <div class="meta">${FX.count(n.chapters,'chapter')} · ${dSizeLine(n)}</div>
      <div class="meta">${H.ago(n.updated_at)} ${n.registered ? '' : `· <span class="badge warn">${t('imported')}</span>`}</div>
    </button></li>`).join('');
  $('#catalog-empty').hidden = S.loading || !!S.catalogError || list.length > 0;
  $('#catalog-loading').textContent=S.catalogError || (S.loading?t('loading'):'');
  $('#catalog-total').textContent = `${FX.count(list.length,'novel')}`;
  $('#page-label').textContent=`${pages?S.page+1:0} / ${pages}`;
  $('#page-previous').disabled=S.page===0;$('#page-next').disabled=S.page+1>=pages;
}

/* ---------------- Reader ---------------- */
function dRenderReader() {
  const n = S.novel, body = H.body(n.novel_id);
  $('#rbar-title').textContent = n.title;
  $('#reader-content').lang = n.language === 'en' ? 'en' : n.language === 'zh-Hans' ? 'zh-Hans' : 'zh-Hant';
  $('#chapter-nav').innerHTML = body.map((c, i) => `<li><button class="chapter-link" type="button" data-jump="chapter-${i + 1}">${H.esc(c.title)}</button>
      ${c.scenes.map((s) => { const f = FX.sceneFacts(s.meta); return `<div class="scn">${f.length ? `${H.transition(s.transition)} · ${f.slice(0, 2).map(([, v]) => H.esc(v)).join(' · ')} · ` : ''}${FX.count(s.blocks.length, 'block')}</div>`; }).join('')}</li>`).join('');
  $('#bookinfo').innerHTML = `<dl>
      <dt>${t('han')}</dt><dd>${H.num(n.han)}</dd><dt>${H.lang === 'en' ? 'Chapters' : '章'}</dt><dd>${n.chapters}</dd>
      <dt>${H.lang === 'en' ? 'Scenes' : t('scenes')}</dt><dd>${n.scenes}</dd><dt>${H.lang === 'en' ? 'Blocks' : t('blocks')}</dt><dd>${n.blocks}</dd>
      <dt>${t('updated')}</dt><dd>${H.date(n.updated_at)}</dd><dt>${t('revision')}</dt><dd class="mono">${n.head_revision_id}</dd></dl>`;
  let bi = 0;
  const chapters = body.map((c, i) => `
    <section class="chapter-section" id="chapter-${i + 1}" data-title="${H.esc(c.title)}">
      <h2>${H.esc(c.title)}</h2>
      ${c.scenes.map((s) => `
        ${(() => { const f = FX.sceneFacts(s.meta); if (!f.length) return ''; const ic = { time: dIcons.clock, location: dIcons.pin, weather: dIcons.rain, people: dIcons.people };
          return `<p class="scene-meta" aria-label="Scene"><span>${dIcons.scene}${H.transition(s.transition)}</span>${f.map(([k, v]) => `<span>${ic[k]}${H.esc(v)}</span>`).join('')}</p>`; })()}
        ${s.blocks.map((b) => b.image
