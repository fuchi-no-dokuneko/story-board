function dCover(n, extra = '') {
  const latin = !/[㐀-鿿]/.test(n.title);
  const stamp = { 'zh-Hant': '繁', 'zh-Hans': '简', 'yue-Hant': '粵', en: 'EN' }[n.language] || n.language;
  return `<span class="cover ${latin ? 'latin' : ''} ${extra}" data-css="--h:${n.hue}"><span class="t">${H.esc(n.title)}</span><span class="stamp">${stamp}</span>${n.images ? `<span class="img">▣ ${n.images}</span>` : ''}</span>`;
}
const dSizeLine = (n) => n.han ? `${H.num(n.han)} ${H.lang === 'en' ? 'Han' : t('han')}` : `${H.num(n.blocks)} ${t('blocks')}`;

/* ---------------- Library ---------------- */
function dRenderLibrary() {
  const last = resumeBook();
  $('#hero').hidden=!last;
  if(last)
  $('#hero').innerHTML = `
    ${dCover(last)}
    <div><p class="eyebrow">${t('continue')}</p><h2 id="hero-title">${H.esc(last.title)}</h2>
      <p class="sub">${H.esc(last.chapterTitle || H.body(last.novel_id)[0]?.title || t('start'))} · ${Math.round(last.progress * 100)}% · ${H.langName(last.language)}</p>
      <div class="prog"><i data-css="width:${last.progress * 100}%"></i></div></div>
    <div class="cta"><button class="btn accent" type="button" data-open="${last.novel_id}">${t('continue')} →</button></div>`;
  const langs = [['all', t('all')], ['zh-Hant', '繁中'], ['zh-Hans', '简中'], ['yue-Hant', H.langName('yue-Hant')], ['en', 'English'], ['imported', t('imported')]];
  $('#filters').innerHTML = langs.map(([k, l]) => `<button class="chip" type="button" data-filter="${k}" aria-pressed="${S.filter === k}">${l}</button>`).join('');
  const list=catalogMatches(),pages=Math.ceil(list.length/12);
  S.page=Math.min(S.page,Math.max(0,pages-1));
