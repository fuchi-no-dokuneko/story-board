    <div class="scroll" id="rscroll"><div class="rtext" lang="${n.language === 'en' ? 'en' : n.language}" data-css="--fs:${S.fs}px;font-family:${S.font === 'serif' ? 'var(--serif)' : 'var(--sans)'}">
