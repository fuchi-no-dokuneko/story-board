const mCover = (n, cls = '') => (cls === 'sm'
  ? `<span class="cover sm" data-css="--h:${n.hue}"><span class="one">${H.esc(n.title[0])}</span></span>`
  : `<span class="cover ${cls} ${/[㐀-鿿]/.test(n.title) ? '' : 'latin'}" data-css="--h:${n.hue}"><span>${H.esc(n.title)}</span></span>`);
const mBook = () => H.novel(S.book);
const mSize = (n) => (n.han ? `${H.num(n.han)} ${t('han')}` : `${H.num(n.blocks)} ${t('blocks').toLowerCase()}`);

/* ---------- screens ---------- */
function mLibScreen() {
  const c = resumeBook();
  const langs = [['all', t('all')], ['zh-Hant', '繁中'], ['zh-Hans', '简中'], ['yue-Hant', '粵語'], ['en', 'EN'], ['imported', t('imported')]];
  const list=catalogMatches();
  return `<div class="screen"><div class="scroll">
    <div class="bigtitle"><h1>${t('library')}</h1><button class="chip" type="button" data-go="set" id="status-text"><i id="status-dot"></i>${t(S.online?'online':'offline')}</button></div>
